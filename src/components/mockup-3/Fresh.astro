---
import { categoryName, formatAdded, formatPrice, freshProducts } from '../../data/products';
import Art from './Art.astro';
---

<section class="fresh" aria-labelledby="m3-fresh">
  <div class="wrap">
    <h2 id="m3-fresh" class="h2">Fresh from the <em>kiln</em></h2>
    <p class="sub">Added in the last day or so, still warm.</p>
    <ul class="row">
      {
        freshProducts.map((p) => (
          <li>
            <a class="pill pebble" href="#">
              <span class="when"><i aria-hidden="true"></i>{formatAdded(p.addedHours)}</span>
              <span class="art" aria-hidden="true">
                <Art profile={p.profile} tone={p.tone} label="" />
              </span>
              <span class="name">{p.title}</span>
              <span class="meta">{categoryName(p.category)} · {formatPrice(p.price)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .fresh {
    margin-top: clamp(5rem, 11vw, 9rem);
  }
  .sub {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: 1.1rem;
  }
  .row {
    display: flex;
    gap: 1.1rem;
    margin: 2rem 0 0;
    padding: 0.5rem 0.25rem 2rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  li {
    flex: 0 0 min(72%, 230px);
    scroll-snap-align: start;
  }
  .pill {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    height: 100%;
    padding: 1rem 1rem 1.25rem;
    border-radius: 120px 120px 36px 36px;
    background: #fbf6ee;
    box-shadow: var(--soft);
    text-align: center;
    text-decoration: none;
    transition: transform 0.5s var(--spring);
  }
  li:nth-child(even) .pill {
    background: #f3e3cf;
  }
  .pill:hover {
    transform: translateY(-8px);
  }
  .pill:active {
    transform: scale(0.97);
  }
  .when {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.8rem;
    border-radius: 999px;
    background: var(--plum);
    color: var(--cream);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .when i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--butter);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      transform: scale(1.7);
      opacity: 0.5;
    }
  }
  .art {
    width: 70%;
    margin: 0.8rem 0 0.4rem;
  }
  .name {
    font: 600 1.15rem/1.2 var(--serif);
  }
  .meta {
    color: var(--muted);
    font-size: 0.9rem;
  }
  @media (min-width: 1100px) {
    .row {
      overflow: visible;
    }
    li {
      flex: 1;
    }
    li:nth-child(odd) {
      margin-top: 1.5rem;
    }
  }
</style>
