---
import { categoryName, formatCount, freeProducts } from '../../data/products';
import Art from './Art.astro';
import Icon from './Icon.astro';

const tilt = [-3, 2, -1.5];
---

<section class="free" id="free" aria-labelledby="m3-free">
  <div class="panel">
    <div class="wrap inner">
      <div class="copy">
        <p class="eyebrow"><Icon name="spark" size={16} /> On the house</p>
        <h2 id="m3-free" class="h2">Take one.<br />They're <em>free.</em></h2>
        <p>
          Planters, pine trees and a pivot script I use every day. Commercial use is fine, no strings and no sign-up
          maze.
        </p>
      </div>
      <ul class="tags">
        {
          freeProducts.map((p, i) => (
            <li style={`--t:${tilt[i]}deg`}>
              <a class="tag pebble" href="#">
                <span class="hole" aria-hidden="true"></span>
                <span class="art" aria-hidden="true">
                  <Art profile={p.profile} tone={p.tone} label="" />
                </span>
                <span class="name">{p.title}</span>
                <span class="sub">{categoryName(p.category)} · {formatCount(p.downloads)} downloads</span>
                <span class="get"><Icon name="download" size={16} /> Get it</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .free {
    margin-top: clamp(5rem, 11vw, 9rem);
  }
  .panel {
    position: relative;
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(4rem, 8vw, 6.5rem);
    background: var(--butter);
    mask:
      radial-gradient(circle 14px at 50% 100%, #0000 97%, #000) bottom / 28px 28px repeat-x,
      linear-gradient(#000, #000) top / 100% calc(100% - 14px) no-repeat;
    border-radius: 48px 48px 0 0;
  }
  .inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .copy p:not(.eyebrow) {
    max-width: 28rem;
    margin: 1.2rem 0 0;
    font-size: 1.1rem;
  }
  .panel :global(.h2 em) {
    color: var(--plum);
    text-decoration: underline wavy var(--clay);
    text-decoration-thickness: 4px;
    text-underline-offset: 8px;
  }
  .tags {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    transform: rotate(var(--t));
    transition: transform 0.5s var(--spring);
  }
  li:hover {
    transform: rotate(0) translateY(-6px);
  }
  .tag {
    position: relative;
    display: grid;
    grid-template-columns: 84px 1fr;
    grid-template-areas: 'art name' 'art sub' 'art get';
    align-items: center;
    gap: 0.1rem 1rem;
    padding: 1.1rem 1.25rem 1.1rem 1rem;
    border-radius: 28px 34px 26px 32px;
    background: #fff8ec;
    box-shadow: var(--soft);
    text-decoration: none;
  }
  .tag:active {
    transform: scale(0.97);
  }
  .hole {
    position: absolute;
    inset: 0.8rem 0.9rem auto auto;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--butter);
    box-shadow: inset 0 2px 3px rgb(0 0 0 / 0.3);
  }
  .art {
    grid-area: art;
    width: 84px;
  }
  .name {
    grid-area: name;
    font: 600 1.25rem/1.15 var(--serif);
  }
  .sub {
    grid-area: sub;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .get {
    grid-area: get;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    justify-self: start;
    min-height: 40px;
    margin-top: 0.3rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--plum);
    color: var(--cream);
    font-weight: 600;
    font-size: 0.9rem;
    transition: background 0.25s;
  }
  .tag:hover .get {
    background: var(--clay);
  }
  @media (min-width: 980px) {
    .inner {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 3rem;
    }
  }
</style>
