---
import { categories, products } from '../../data/products';
import Art from './Art.astro';
import Icon from './Icon.astro';

const look = [
  { bg: '#f3c7b6', pick: 'vase', tone: 0, r: '46% 54% 42% 58% / 52% 44% 56% 48%' },
  { bg: '#cfe0c9', pick: 'helmet', tone: 1, r: '54% 46% 58% 42% / 44% 56% 44% 56%' },
  { bg: '#f6dc9e', pick: 'brush', tone: 3, r: '42% 58% 46% 54% / 56% 48% 52% 44%' },
] as const;
---

<section class="cats" aria-labelledby="m3-cats">
  <div class="wrap">
    <h2 id="m3-cats" class="h2">Three ways to <em>make</em></h2>
    <ul class="grid">
      {
        categories.map((c, i) => {
          const l = look[i];
          const p = products.find((x) => x.profile === l.pick)!;
          return (
            <li>
              <a class="cat pebble" href="#" style={`--bg:${l.bg};--r:${l.r}`}>
                <span class="art" aria-hidden="true">
                  <Art profile={p.profile} tone={l.tone} label="" />
                </span>
                <span class="name">{c.name}</span>
                <span class="blurb">{c.blurb}</span>
                <span class="foot">
                  <span class="count">{c.count} files</span>
                  <span class="go" aria-hidden="true"><Icon name="arrow" size={20} /></span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .cats {
    margin-top: clamp(4rem, 9vw, 7rem);
  }
  .grid {
    display: grid;
    gap: 1.25rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .cat {
    position: relative;
    display: grid;
    gap: 0.25rem;
    height: 100%;
    padding: 1.5rem 1.5rem 1.25rem;
    border-radius: var(--r);
    background: var(--bg);
    box-shadow: var(--soft);
    text-decoration: none;
    transition: transform 0.5s var(--spring), border-radius 0.8s var(--spring);
  }
  .cat:hover {
    transform: translateY(-8px) rotate(-0.8deg);
    border-radius: 40px;
  }
  .cat:active {
    transform: scale(0.98);
  }
  .art {
    display: block;
    width: min(62%, 240px);
    margin: 0 auto 0.5rem;
  }
  .name {
    font: 600 clamp(1.5rem, 2.6vw, 2rem)/1.1 var(--serif);
    letter-spacing: -0.015em;
  }
  .blurb {
    color: #4c3a44;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.8rem;
  }
  .count {
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.65);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .go {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--plum);
    color: var(--cream);
    transition: transform 0.45s var(--spring);
  }
  .cat:hover .go {
    transform: translateX(4px) rotate(-12deg) scale(1.08);
  }
  @media (min-width: 820px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      align-items: start;
    }
    li:nth-child(2) {
      margin-top: 2.5rem;
    }
    li:nth-child(3) {
      margin-top: 1rem;
    }
  }
</style>
