---
import { PROFILES, type ProfileName } from '../../data/products';

interface Props {
  profile: ProfileName;
  tone: number;
  label: string;
}
const { profile, tone, label } = Astro.props;

const mat = ['clay', 'jade', 'wax', 'violet'][tone];
const prof = PROFILES[profile];
const CX = 100;
const BASE = 192;
const HT = 168;
const R = 82;
const right = prof.map((r, i) => [CX + Math.max(r, 0.03) * R, BASE - (i * HT) / (prof.length - 1)]);
const left = right.map(([x, y]) => [2 * CX - x, y]).reverse();

// Catmull-Rom spline converted to cubic Béziers for a soft, sculpted silhouette.
const smooth = (pts: number[][]) => {
  let d = '';
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[Math.max(i - 1, 0)];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[Math.min(i + 2, pts.length - 1)];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += `C${c1[0].toFixed(1)} ${c1[1].toFixed(1)} ${c2[0].toFixed(1)} ${c2[1].toFixed(1)} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
  }
  return d;
};
const d = `M${right[0][0].toFixed(1)} ${right[0][1]}${smooth(right)}L${left[0][0].toFixed(1)} ${left[0][1].toFixed(1)}${smooth(left)}Z`;
const baseW = prof[0] * R;
---

<svg
  viewBox="0 0 200 210"
  class="sculpt"
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <ellipse class="contact" cx={CX} cy={BASE + 4} rx={baseW * 1.15} ry="8" fill="#2a1a24" opacity="0.2"></ellipse>
  <g class="obj">
    <path {d} fill={`url(#mat-${mat})`}></path>
    <path {d} fill="url(#m3-shade)"></path>
  </g>
</svg>

<style>
  .sculpt {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .obj {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transition: transform 0.5s var(--spring);
  }
  .contact {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.5s var(--spring), opacity 0.4s;
  }
  :global(.pebble:hover) .obj,
  :global(.pebble:focus-within) .obj {
    transform: translateY(-8px) scale(1.04, 0.98);
  }
  :global(.pebble:hover) .contact,
  :global(.pebble:focus-within) .contact {
    transform: scale(0.85);
    opacity: 0.12;
  }
</style>
