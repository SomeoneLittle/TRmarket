---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import { href } from '../../data/products';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

// Matcap-style materials shared by every sculpture on the page.
const materials = [
  { id: 'clay', stops: ['#f6b8a0', '#d4694b', '#a43f27', '#6d2516'] },
  { id: 'jade', stops: ['#d9f1e4', '#86c4a7', '#3f8068', '#1f4a3b'] },
  { id: 'wax', stops: ['#fff4d1', '#f4cb70', '#c48c2c', '#7c5412'] },
  { id: 'violet', stops: ['#e6d6f7', '#a982d8', '#6a41a3', '#3c2266'] },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6eee3" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
  </head>
  <body class="m3">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        {
          materials.map((m) => (
            <radialGradient id={`mat-${m.id}`} cx="0.34" cy="0.3" r="0.9">
              <stop offset="0" stop-color={m.stops[0]} />
              <stop offset="0.32" stop-color={m.stops[1]} />
              <stop offset="0.68" stop-color={m.stops[2]} />
              <stop offset="1" stop-color={m.stops[3]} />
            </radialGradient>
          ))
        }
        <radialGradient id="mat-chrome" cx="0.34" cy="0.3" r="0.9">
          <stop offset="0" stop-color="#ffffff" />
          <stop offset="0.25" stop-color="#cfd6df" />
          <stop offset="0.45" stop-color="#586374" />
          <stop offset="0.62" stop-color="#e6ebf1" />
          <stop offset="0.82" stop-color="#7d8898" />
          <stop offset="1" stop-color="#262d39" />
        </radialGradient>
        <linearGradient id="m3-shade" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#23101c" stop-opacity="0.45" />
          <stop offset="0.18" stop-color="#23101c" stop-opacity="0.08" />
          <stop offset="0.32" stop-color="#ffffff" stop-opacity="0.34" />
          <stop offset="0.4" stop-color="#ffffff" stop-opacity="0" />
          <stop offset="0.7" stop-color="#ffffff" stop-opacity="0" />
          <stop offset="1" stop-color="#23101c" stop-opacity="0.4" />
        </linearGradient>
      </defs>
    </svg>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <a class="back" href={href()} lang="ru">← к выбору макетов</a>
  </body>
</html>

<style is:global>
  .m3 {
    --cream: #f6eee3;
    --cream-2: #efe3d2;
    --sand: #e6d4bb;
    --plum: #2a1a24;
    --muted: #6b5560;
    --clay: #b9472f;
    --clay-soft: #f3c7b6;
    --butter: #f4c76a;
    --sage: #a9c2a4;
    --serif: 'Fraunces Variable', Georgia, serif;
    --sans: 'Inter Variable', system-ui, sans-serif;
    --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    --soft: inset 0 -6px 14px rgb(120 60 30 / 0.1), inset 0 6px 12px rgb(255 255 255 / 0.75),
      0 16px 28px -14px rgb(42 26 36 / 0.35);
    --wrap: min(1320px, 100% - clamp(32px, 7vw, 88px));
  }
  .m3 {
    margin: 0;
    background: var(--cream);
    color: var(--plum);
    font-family: var(--sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .m3 *,
  .m3 *::before,
  .m3 *::after {
    box-sizing: border-box;
  }
  .m3 a {
    color: inherit;
  }
  .m3 :focus-visible {
    outline: 3px solid var(--plum);
    outline-offset: 3px;
    border-radius: 12px;
  }
  .m3 .dark :focus-visible {
    outline-color: var(--butter);
  }
  .m3 .wrap {
    width: var(--wrap);
    margin-inline: auto;
  }
  .m3 .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .m3 .skip {
    position: fixed;
    inset: 10px auto auto 10px;
    z-index: 100;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    background: var(--plum);
    color: var(--cream);
    transform: translateY(-200%);
  }
  .m3 .skip:focus {
    transform: none;
  }
  .m3 .back {
    position: fixed;
    inset: auto auto 14px 14px;
    z-index: 90;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: var(--plum);
    color: var(--cream);
    font-family: system-ui, sans-serif;
    font-size: 0.78rem;
    text-decoration: none;
    box-shadow: 0 8px 20px -8px rgb(42 26 36 / 0.6);
    transition: transform 0.35s var(--spring), background 0.2s;
  }
  .m3 .back:hover {
    transform: translateY(-2px) scale(1.04);
    background: var(--clay);
  }
  .m3 .back:active {
    transform: scale(0.96);
  }
  .m3 .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 52px;
    padding: 0 1.6rem;
    border: 0;
    border-radius: 999px;
    background: var(--clay);
    color: #fff;
    font: 600 1rem/1 var(--sans);
    text-decoration: none;
    box-shadow: inset 0 -5px 10px rgb(0 0 0 / 0.18), inset 0 5px 10px rgb(255 255 255 / 0.25),
      0 14px 24px -12px rgb(185 71 47 / 0.8);
    cursor: pointer;
    transition: transform 0.4s var(--spring), box-shadow 0.3s;
  }
  .m3 .btn:hover {
    transform: translateY(-3px) scale(1.03);
  }
  .m3 .btn:active {
    transform: translateY(1px) scale(0.97);
    box-shadow: inset 0 4px 10px rgb(0 0 0 / 0.25), 0 4px 8px -4px rgb(185 71 47 / 0.8);
  }
  .m3 .btn.soft {
    background: var(--cream-2);
    color: var(--plum);
    box-shadow: var(--soft);
  }
  .m3 .h2 {
    margin: 0;
    font: 600 clamp(2.2rem, 5.4vw, 4rem)/1.02 var(--serif);
    letter-spacing: -0.025em;
  }
  .m3 .h2 em {
    font-style: italic;
    font-weight: 500;
    color: var(--clay);
  }
  .m3 .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.9rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background: var(--cream-2);
    box-shadow: var(--soft);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  @media (prefers-reduced-motion: reduce) {
    .m3 * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
