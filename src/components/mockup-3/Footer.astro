---
const columns = [
  { title: 'Shop', links: ['Catalog', '3D models for print', '3D models for games', 'Tools & add-ons', 'Free downloads'] },
  { title: 'Read', links: ['Blog', 'Changelog', 'Printing guide'] },
  { title: 'Fine print', links: ['Privacy policy', 'Terms of sale (offer)', 'Licences', 'Refunds & returns'] },
  { title: 'Say hi', links: ['Contacts', 'My downloads', 'Report a problem'] },
];
const socials = [
  { label: 'YouTube', short: 'Yt' },
  { label: 'Discord', short: 'Dc' },
  { label: 'Instagram', short: 'Ig' },
  { label: 'X', short: 'X' },
];
---

<footer class="ft dark">
  <svg class="wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 60V28c120 32 240 32 360 8s240-36 360-24 240 40 360 36 240-30 360-28v40z" fill="currentColor"></path>
  </svg>
  <div class="wrap">
    <p class="tag">Made by hand,<br /><em>shipped by file.</em></p>
    <div class="cols">
      {
        columns.map((c) => (
          <nav aria-label={c.title}>
            <h2>{c.title}</h2>
            <ul>
              {c.links.map((l) => (
                <li>
                  <a href="#">{l}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <ul class="soc" aria-label="Social networks">
      {
        socials.map((s) => (
          <li>
            <a href="#" aria-label={s.label}>{s.short}</a>
          </li>
        ))
      }
    </ul>
    <p class="legal">
      TRmarket · Sole proprietor Full Name · Reg. No. 000 000 000 · Tax ID 0000000000 · 00 Placeholder St., City, Country
      · hello@example.com
    </p>
    <p class="legal">© 2026 TRmarket. All models are digital goods; licence terms apply.</p>
  </div>
</footer>

<style>
  .ft {
    position: relative;
    margin-top: clamp(5rem, 11vw, 9rem);
    padding: 3rem 0 5rem;
    background: var(--plum);
    color: var(--cream);
  }
  .wave {
    position: absolute;
    inset: -59px 0 auto;
    width: 100%;
    height: 60px;
    color: var(--plum);
  }
  .tag {
    margin: 0 0 2.5rem;
    font: 600 clamp(2.4rem, 7vw, 5.5rem)/1 var(--serif);
    letter-spacing: -0.03em;
  }
  .tag em {
    font-style: italic;
    font-weight: 500;
    color: var(--butter);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
  }
  h2 {
    margin: 0 0 0.6rem;
    font: 600 1.15rem var(--serif);
    color: var(--butter);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cols a {
    display: inline-block;
    padding: 0.35rem 0;
    color: #e8dccb;
    text-decoration: none;
    transition: color 0.2s, transform 0.35s var(--spring);
  }
  .cols a:hover {
    color: #fff;
    transform: translateX(4px);
  }
  .cols a:active {
    color: var(--butter);
  }
  .soc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 2.5rem 0 0;
  }
  .soc a {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #3d2a37;
    color: var(--cream);
    font-weight: 700;
    text-decoration: none;
    box-shadow: inset 0 3px 6px rgb(255 255 255 / 0.12), inset 0 -3px 6px rgb(0 0 0 / 0.25);
    transition: transform 0.4s var(--spring), background 0.2s, color 0.2s;
  }
  .soc a:hover {
    background: var(--butter);
    color: var(--plum);
    transform: translateY(-4px) rotate(-6deg);
  }
  .soc a:active {
    transform: scale(0.92);
  }
  .legal {
    max-width: 58rem;
    margin: 1.5rem 0 0;
    color: #cdbfae;
    font-size: 0.85rem;
  }
  .legal + .legal {
    margin-top: 0.4rem;
  }
  @media (min-width: 760px) {
    .cols {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
