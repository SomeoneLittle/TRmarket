---
import {
  categories,
  categoryName,
  formatAdded,
  formatCount,
  formatPrice,
  freeProducts,
  freshProducts,
  products,
} from '../../data/products';
import Art from './Art.astro';
import Card from './Card.astro';
import Icon from './Icon.astro';

const sample = {
  print: products.find((p) => p.id === 'orbital-pawn-chess')!,
  game: products.find((p) => p.id === 'mushroom-village-kit')!,
  tool: products.find((p) => p.id === 'quad-remesh-pro')!,
};
const tint = { print: '#2a211c', game: '#1c2622', tool: '#1c2029' };
const browse = [...products].sort((a, b) => b.downloads - a.downloads);
const chips = [
  { id: 'all', label: 'All', n: products.length },
  { id: 'print', label: '3D print', n: products.filter((p) => p.category === 'print').length },
  { id: 'game', label: 'Game-ready', n: products.filter((p) => p.category === 'game').length },
  { id: 'tool', label: 'Tools', n: products.filter((p) => p.category === 'tool').length },
  { id: 'free', label: 'Free', n: freeProducts.length },
  { id: 'sale', label: 'On sale', n: products.filter((p) => p.oldPrice).length },
];
---

<section class="sec wrap" aria-labelledby="m5-cats">
  <div class="sec-head">
    <div>
      <h2 class="t" id="m5-cats">Browse by category</h2>
      <p class="sub">Three shelves, one author. Everything tested before it ships.</p>
    </div>
  </div>
  <ul class="cats">
    {
      categories.map((c) => (
        <li>
          <a class="cat" href="#" style={`--t:${tint[c.id]}`}>
            <span class="n">{c.count}<small>items</small></span>
            <span class="name">{c.name}</span>
            <span class="blurb">{c.blurb}</span>
            <span class="go">Browse <Icon name="arrow" size={16} /></span>
            <span class="pic" aria-hidden="true"><Art product={sample[c.id]} /></span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<section class="sec wrap" id="catalog" aria-labelledby="m5-pop">
  <div class="sec-head">
    <div>
      <h2 class="t" id="m5-pop">Popular products</h2>
      <p class="sub">Showing <b data-count>{products.length}</b> products</p>
    </div>
    <a class="link" href="#">Open full catalog <Icon name="arrow" size={16} /></a>
  </div>
  <div class="chips" role="group" aria-label="Filter products">
    {chips.map((c) => (
      <button type="button" data-chip={c.id} aria-pressed={c.id === 'all' ? 'true' : 'false'}>{c.label} <small>{c.n}</small></button>
    ))}
  </div>
  <ul class="grid">
    {
      browse.map((p) => (
        <li data-cell>
          <Card product={p} />
        </li>
      ))
    }
  </ul>
</section>

<section class="sec wrap" id="free" aria-labelledby="m5-free">
  <div class="sec-head">
    <div>
      <h2 class="t" id="m5-free">Free models &amp; tools</h2>
      <p class="sub">Free to download. Commercial use is fine.</p>
    </div>
    <div class="arrows">
      <button type="button" data-rail="-1" aria-label="Scroll left"><Icon name="chevron-left" size={20} /></button>
      <button type="button" data-rail="1" aria-label="Scroll right"><Icon name="chevron-right" size={20} /></button>
    </div>
  </div>
  <div class="rail" data-railbox tabindex="0" role="region" aria-label="Free products">
    <ul>
      {
        freeProducts.map((p) => (
          <li>
            <article class="fcard">
              <div class="ft"><Art product={p} /></div>
              <div class="fi">
                <h3>{p.title}</h3>
                <p>{categoryName(p.category)} · {formatCount(p.downloads)} downloads</p>
                <button class="btn" type="button" data-add data-title={p.title} data-price="0" data-kind={`${p.kind} · ${p.formats.join(', ')}`}>
                  <Icon name="download" size={17} /> Get for free
                </button>
              </div>
            </article>
          </li>
        ))
      }
      <li>
        <a class="fcard more" href="#">
          <span class="big">More free stuff</span>
          <span>New freebies every month</span>
          <span class="go"><Icon name="arrow" size={22} /></span>
        </a>
      </li>
      <li>
        <a class="fcard more alt" href="#">
          <span class="big">Join the newsletter</span>
          <span>Get a free pack on sign-up</span>
          <span class="go"><Icon name="arrow" size={22} /></span>
        </a>
      </li>
    </ul>
  </div>
</section>

<section class="sec wrap feed" aria-labelledby="m5-new">
  <div class="lead">
    <h2 class="t" id="m5-new">Added today</h2>
    <p class="sub">Fresh files from the last 30 hours. New drops land every few days.</p>
    <a class="btn ghost" href="#">All new arrivals</a>
  </div>
  <ol class="rows">
    {
      freshProducts.map((p) => (
        <li>
          <div class="row">
            <span class="when">{formatAdded(p.addedHours)}</span>
            <a class="rthumb" href="#" tabindex="-1" aria-hidden="true"><Art product={p} /></a>
            <span class="rinfo">
              <a href="#"><b>{p.title}</b></a>
              <small>{categoryName(p.category)} · {p.formats.join(', ')}</small>
            </span>
            <b class="rp">{formatPrice(p.price)}</b>
            <button class="ra" type="button" data-add data-title={p.title} data-price={p.price} data-kind={`${p.kind} · ${p.formats.join(', ')}`} aria-label={`Add ${p.title} to cart`}>
              <Icon name={p.price === 0 ? 'download' : 'plus'} size={18} />
            </button>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .cats {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cat {
    position: relative;
    display: grid;
    gap: 4px;
    align-content: start;
    min-height: 240px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: linear-gradient(145deg, var(--t), #121214 70%);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.3s var(--ease);
  }
  .cat:hover {
    border-color: #444;
    transform: translateY(-4px);
  }
  .n {
    font-size: 3.2rem;
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .n small {
    margin-left: 6px;
    color: var(--mut);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0;
  }
  .name {
    margin-top: 10px;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .blurb {
    max-width: 14rem;
    color: var(--mut);
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    color: var(--acc-h);
    font-weight: 650;
  }
  .go :global(svg) {
    transition: transform 0.25s var(--ease);
  }
  .cat:hover .go :global(svg),
  .more:hover .go :global(svg) {
    transform: translateX(5px);
  }
  .pic {
    position: absolute;
    inset: auto -4% -8% auto;
    width: 52%;
    aspect-ratio: 1;
    transition: transform 0.5s var(--ease);
  }
  .cat:hover .pic {
    transform: translate(-8px, -8px) scale(1.06);
  }

  .chips {
    display: flex;
    gap: 8px;
    margin: 0 0 18px;
    padding-block: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .chips button {
    flex: none;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: var(--s1);
    color: var(--mut);
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s, transform 0.2s var(--ease);
  }
  .chips button small {
    margin-left: 4px;
    opacity: 0.7;
  }
  .chips button:hover {
    border-color: #4a4a52;
    color: var(--text);
  }
  .chips button:active {
    transform: scale(0.95);
  }
  .chips button[aria-pressed='true'] {
    border-color: var(--text);
    background: var(--text);
    color: #111;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .arrows {
    display: none;
    gap: 8px;
  }
  .arrows button {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--s1);
    cursor: pointer;
    transition: background 0.15s, opacity 0.15s, transform 0.15s;
  }
  .arrows button:hover:not(:disabled) {
    background: var(--s3);
  }
  .arrows button:active:not(:disabled) {
    transform: scale(0.92);
  }
  .arrows button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .rail {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .rail ul {
    display: flex;
    gap: 14px;
    margin: 0;
    padding: 0 0 4px;
    list-style: none;
  }
  .rail li {
    flex: 0 0 min(300px, 78%);
    scroll-snap-align: start;
  }
  .fcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--s1);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.3s var(--ease);
  }
  .fcard:hover {
    border-color: #444;
    transform: translateY(-3px);
  }
  .ft {
    aspect-ratio: 1 / 0.7;
    background: radial-gradient(ellipse 80% 80% at 50% 40%, #2c2c31, #131315 80%);
  }
  .ft :global(.art) {
    padding: 4%;
  }
  .fi {
    display: grid;
    gap: 4px;
    padding: 16px;
  }
  .fi h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .fi p {
    margin: 0 0 8px;
    color: var(--mut);
    font-size: 0.9rem;
  }
  .fcard.more {
    justify-content: flex-end;
    gap: 4px;
    padding: 24px;
    min-height: 100%;
    background: linear-gradient(160deg, #15251d, #0f1512);
    color: var(--mut);
    text-decoration: none;
  }
  .fcard.more.alt {
    background: linear-gradient(160deg, #20202a, #131316);
  }
  .big {
    color: var(--text);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .feed {
    display: grid;
    gap: 24px;
  }
  .lead .btn {
    margin-top: 16px;
  }
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 64px 1fr auto auto;
    grid-template-areas: 'when when when when' 'thumb info price add';
    align-items: center;
    gap: 6px 14px;
    padding: 14px 8px;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    transition: background 0.2s, padding 0.25s var(--ease);
  }
  .row:hover {
    background: var(--s1);
    padding-inline: 18px;
  }
  .when {
    grid-area: when;
    color: var(--acc);
    font-size: 0.82rem;
    font-weight: 600;
  }
  .rthumb {
    grid-area: thumb;
    width: 64px;
    height: 56px;
    border-radius: 10px;
    background: radial-gradient(ellipse at 50% 40%, #2c2c31, #131315 80%);
  }
  .rinfo {
    grid-area: info;
    display: grid;
    min-width: 0;
  }
  .rinfo a {
    text-decoration: none;
  }
  .rinfo a:hover {
    text-decoration: underline;
  }
  .rinfo small {
    color: var(--mut);
  }
  .rp {
    grid-area: price;
  }
  .ra {
    grid-area: add;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid #3b3b42;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s, transform 0.2s var(--ease);
  }
  .ra:hover {
    border-color: var(--acc);
    background: var(--acc);
    color: #04210f;
  }
  .ra:active {
    transform: scale(0.9);
  }
  @media (min-width: 700px) {
    .cats {
      grid-template-columns: repeat(3, 1fr);
    }
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px 20px;
    }
    .arrows {
      display: flex;
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .chips {
      position: sticky;
      top: 70px;
      z-index: 20;
      margin-inline: 0;
      padding: 10px 0;
      background: linear-gradient(var(--bg) 75%, transparent);
    }
    .feed {
      grid-template-columns: 340px minmax(0, 1fr);
      gap: 64px;
    }
    .lead {
      align-self: start;
      position: sticky;
      top: 110px;
    }
    .row {
      grid-template-columns: 110px 64px 1fr auto auto;
      grid-template-areas: 'when thumb info price add';
    }
  }
</style>

<script>
  // Category filter with a quick fade/scale transition.
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-chip]')];
  const cells = [...document.querySelectorAll<HTMLElement>('[data-cell]')];
  const count = document.querySelector<HTMLElement>('[data-count]')!;

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const f = chip.dataset.chip!;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      let shown = 0;
      cells.forEach((cell) => {
        const card = cell.querySelector<HTMLElement>('.card')!;
        const match = f === 'all' || card.dataset.tags!.split(' ').includes(f);
        if (match) {
          shown++;
          if (cell.hidden) {
            cell.hidden = false;
            card.classList.add('out');
            requestAnimationFrame(() => requestAnimationFrame(() => card.classList.remove('out')));
          } else {
            card.classList.remove('out');
          }
        } else {
          card.classList.add('out');
          setTimeout(() => {
            if (card.classList.contains('out')) cell.hidden = true;
          }, 260);
        }
      });
      count.textContent = String(shown);
    }),
  );

  // Free rail arrows.
  const rail = document.querySelector<HTMLElement>('[data-railbox]');
  const arrows = [...document.querySelectorAll<HTMLButtonElement>('[data-rail]')];
  if (rail) {
    const update = () => {
      arrows[0].disabled = rail.scrollLeft < 4;
      arrows[1].disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 4;
    };
    arrows.forEach((a) =>
      a.addEventListener('click', () => rail.scrollBy({ left: Number(a.dataset.rail) * rail.clientWidth * 0.8 })),
    );
    rail.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
