---
import Icon from './Icon.astro';

const nav = [
  { label: 'Home', current: true },
  { label: 'Marketplace' },
  { label: 'Blog' },
];
---

<header class="hd">
  <div class="wrap in">
    <a class="logo" href="#" aria-label="TRmarket, home">
      <span class="mark" aria-hidden="true">TR</span>market
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href="#" aria-current={n.current ? 'page' : undefined}>{n.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <form class="search" role="search" action="#" onsubmit="return false">
      <label class="sr" for="m5-q">Search</label>
      <Icon name="search" size={19} />
      <input id="m5-q" type="search" placeholder="Search models, brushes, add-ons" autocomplete="off" />
    </form>
    <div class="acts">
      <a class="ib" href="#" aria-label="Favorites"><Icon name="heart" size={22} /></a>
      <a class="ib" href="#" aria-label="Account"><Icon name="user" size={22} /></a>
      <button class="ib bag" type="button" data-open-cart>
        <span class="sr">Open cart</span>
        <Icon name="bag" size={22} />
        <b data-cart-count>2</b>
      </button>
    </div>
  </div>
</header>

<style>
  .hd {
    position: relative;
    z-index: 100;
    border-bottom: 1px solid var(--line);
    background: rgb(10 10 11 / 0.9);
    backdrop-filter: blur(12px);
  }
  .in {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'logo acts' 'nav nav' 'search search';
    gap: 8px 12px;
    align-items: center;
    padding-block: 12px;
  }
  .logo {
    grid-area: logo;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    width: max-content;
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    text-decoration: none;
  }
  .mark {
    margin-right: 1px;
    padding: 1px 7px;
    border-radius: 7px;
    background: var(--acc);
    color: #04210f;
  }
  nav {
    grid-area: nav;
  }
  ul {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 99px;
    color: var(--mut);
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  nav a:hover {
    background: var(--s2);
    color: var(--text);
  }
  nav a[aria-current] {
    background: var(--s3);
    color: var(--text);
  }
  .search {
    grid-area: search;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: var(--s1);
    color: var(--mut);
    transition: border-color 0.15s, background 0.15s;
  }
  .search:hover {
    background: var(--s2);
  }
  .search:focus-within {
    border-color: var(--acc);
    background: var(--s1);
  }
  input {
    flex: 1;
    min-width: 0;
    min-height: 46px;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
  }
  input:focus {
    outline: none;
  }
  input::placeholder {
    color: #8e8e98;
  }
  .acts {
    grid-area: acts;
    display: flex;
    gap: 2px;
    justify-self: end;
  }
  .ib {
    position: relative;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    transition: background 0.15s;
  }
  .ib:hover {
    background: var(--s3);
  }
  .bag b {
    position: absolute;
    inset: 2px 0 auto auto;
    display: grid;
    place-items: center;
    min-width: 19px;
    height: 19px;
    padding: 0 5px;
    border-radius: 99px;
    background: var(--acc);
    color: #04210f;
    font-size: 0.72rem;
  }
  @media (min-width: 960px) {
    .hd {
      position: sticky;
      top: 0;
    }
    .in {
      grid-template-columns: auto auto minmax(260px, 1fr) auto;
      grid-template-areas: 'logo nav search acts';
      gap: 20px;
    }
  }
</style>
