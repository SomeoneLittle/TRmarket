---
import { products } from '../../data/products';
import Art from './Art.astro';
import Icon from './Icon.astro';

const p = products.find((x) => x.id === 'sentinel-helmet-kit')!;
const views = [
  { id: 'render', label: 'Render' },
  { id: 'clay', label: 'Clay' },
  { id: 'wire', label: 'Wireframe' },
];
const perks = ['Instant download after payment', 'Lifetime updates included', 'Commercial use on the Commercial licence'];
---

<section class="hero wrap" aria-labelledby="m5-feat">
  <h1 class="sr">TRmarket: 3D models and modeling tools</h1>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="#">Home</a><span aria-hidden="true">/</span><a href="#">Marketplace</a><span aria-hidden="true">/</span><span aria-current="page">3D models for games</span>
  </nav>

  <div class="grid">
    <div class="gallery">
      <div class="stage" data-stage data-view="render">
        <Art product={p} label="Sentinel Helmet Kit preview" />
        <span class="live-tag">Featured this week</span>
      </div>
      <div class="seg" role="group" aria-label="Preview mode" style="--n:3">
        <i class="knob" aria-hidden="true"></i>
        {views.map((v, i) => <button type="button" data-v={v.id} aria-pressed={i === 0 ? 'true' : 'false'}>{v.label}</button>)}
      </div>
    </div>

    <div class="info">
      <p class="kicker">{p.kind} · {p.formats.join(', ')}</p>
      <h2 id="m5-feat">{p.title}</h2>
      <p class="rate"><Icon name="star" size={16} /> <b>{p.rating.toFixed(1)}</b> <span>{p.reviews} reviews · {p.downloads.toLocaleString('en-US')} downloads</span></p>
      <p class="price"><b data-price-out>$24</b><s data-old-out>$32</s><em data-off-out>−25%</em></p>
      <p class="desc">{p.blurb} Includes a high-poly sculpt, a game-ready mesh and a printable version.</p>

      <fieldset class="lic">
        <legend>Licence</legend>
        <label>
          <input type="radio" name="m5-lic" value="personal" data-price="24" data-old="32" checked />
          <span class="card"><b>Personal</b><small>Hobby and non-commercial</small><i>$24</i></span>
        </label>
        <label>
          <input type="radio" name="m5-lic" value="commercial" data-price="48" data-old="64" />
          <span class="card"><b>Commercial</b><small>Games, clients, stores</small><i>$48</i></span>
        </label>
      </fieldset>

      <div class="cta">
        <button class="btn" type="button" data-add data-title="Sentinel Helmet Kit (Personal)" data-price="24" data-kind="Game-ready asset · FBX, GLB, BLEND" data-main-add>
          <Icon name="bag" size={19} /> Add to cart
        </button>
        <a class="btn ghost" href="#">Buy now</a>
      </div>
      <ul class="perks">
        {perks.map((t) => <li><Icon name="check" size={16} /> {t}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 18px;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
    color: var(--mut);
    font-size: 0.88rem;
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .crumbs [aria-current] {
    color: var(--text);
  }
  .grid {
    display: grid;
    gap: 24px;
  }
  .stage {
    position: relative;
    aspect-ratio: 1 / 0.92;
    border-radius: 22px;
    background:
      radial-gradient(ellipse 60% 40% at 50% 92%, rgb(255 255 255 / 0.07), transparent 70%),
      radial-gradient(ellipse 85% 80% at 50% 38%, #34343a, #101012 80%);
    overflow: hidden;
  }
  .stage :global(.art) {
    padding: 8%;
    animation: float 7s ease-in-out infinite;
  }
  @keyframes float {
    50% {
      transform: translateY(-8px);
    }
  }
  .live-tag {
    position: absolute;
    inset: 16px auto auto 16px;
    padding: 4px 12px;
    border-radius: 99px;
    background: rgb(0 0 0 / 0.5);
    backdrop-filter: blur(6px);
    font-size: 0.82rem;
    font-weight: 600;
  }
  .seg {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    width: min(100%, 380px);
    margin: 14px auto 0;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: var(--s1);
  }
  .knob {
    position: absolute;
    inset: 4px auto 4px 4px;
    width: calc((100% - 8px) / var(--n));
    border-radius: 99px;
    background: var(--s3);
    transform: translateX(calc(var(--i, 0) * 100%));
    transition: transform 0.35s var(--ease);
  }
  .seg button {
    position: relative;
    min-height: 44px;
    border: 0;
    border-radius: 99px;
    background: none;
    color: var(--mut);
    font-weight: 600;
    cursor: pointer;
    transition: color 0.15s;
  }
  .seg button:hover,
  .seg button[aria-pressed='true'] {
    color: var(--text);
  }
  .kicker {
    margin: 0 0 6px;
    color: var(--acc);
    font-size: 0.9rem;
    font-weight: 600;
  }
  h2 {
    margin: 0;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    font-weight: 750;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .rate {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 12px 0 0;
    color: var(--mut);
  }
  .rate :global(svg) {
    color: #ffc247;
    fill: #ffc247;
  }
  .rate b {
    color: var(--text);
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 16px 0 0;
  }
  .price b {
    font-size: 2.4rem;
    letter-spacing: -0.03em;
  }
  .price s {
    color: var(--mut);
    font-size: 1.15rem;
  }
  .price em {
    padding: 2px 10px;
    border-radius: 99px;
    background: rgb(255 107 107 / 0.16);
    color: var(--sale);
    font-style: normal;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .desc {
    max-width: 34rem;
    margin: 14px 0 18px;
    color: #cfcfd6;
  }
  .lic {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 0 0 18px;
    padding: 0;
    border: 0;
  }
  legend {
    margin-bottom: 8px;
    padding: 0;
    color: var(--mut);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .lic label {
    position: relative;
    cursor: pointer;
  }
  .lic input {
    position: absolute;
    opacity: 0;
    inset: 0;
  }
  .lic .card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 8px;
    height: 100%;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--s1);
    transition: border-color 0.2s, background 0.2s, transform 0.2s var(--ease);
  }
  .lic small {
    grid-column: 1;
    color: var(--mut);
  }
  .lic i {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    font-style: normal;
    font-weight: 700;
    font-size: 1.15rem;
  }
  .lic label:hover .card {
    border-color: #44444c;
    transform: translateY(-2px);
  }
  .lic input:checked + .card {
    border-color: var(--acc);
    background: rgb(61 220 151 / 0.08);
    box-shadow: 0 0 0 1px var(--acc);
  }
  .lic input:focus-visible + .card {
    outline: 2px solid var(--acc);
    outline-offset: 3px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cta .btn {
    flex: 1 1 180px;
  }
  .perks {
    display: grid;
    gap: 6px;
    margin: 18px 0 0;
    padding: 0;
    color: var(--mut);
    list-style: none;
    font-size: 0.92rem;
  }
  .perks li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .perks :global(svg) {
    color: var(--acc);
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 48px;
      align-items: center;
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const seg = document.querySelector<HTMLElement>('.seg');
  if (stage && seg) {
    const buttons = [...seg.querySelectorAll<HTMLButtonElement>('button')];
    buttons.forEach((b, i) =>
      b.addEventListener('click', () => {
        stage.dataset.view = b.dataset.v;
        seg.style.setProperty('--i', String(i));
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      }),
    );
  }

  const add = document.querySelector<HTMLElement>('[data-main-add]');
  const out = document.querySelector<HTMLElement>('[data-price-out]');
  const old = document.querySelector<HTMLElement>('[data-old-out]');
  document.querySelectorAll<HTMLInputElement>('input[name="m5-lic"]').forEach((r) =>
    r.addEventListener('change', () => {
      if (!add || !out || !old) return;
      out.textContent = `$${r.dataset.price}`;
      old.textContent = `$${r.dataset.old}`;
      add.dataset.price = r.dataset.price;
      add.dataset.title = `Sentinel Helmet Kit (${r.value === 'personal' ? 'Personal' : 'Commercial'})`;
    }),
  );
</script>
