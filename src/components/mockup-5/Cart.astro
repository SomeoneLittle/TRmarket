---
import Icon from './Icon.astro';
---

<div class="scrim" data-close-cart hidden></div>
<aside class="drawer" id="m5-cart" role="dialog" aria-modal="true" aria-labelledby="m5-cart-title" aria-hidden="true" inert>
  <header>
    <h2 id="m5-cart-title">Your cart <span data-cart-count>0</span></h2>
    <button class="x" type="button" data-close-cart aria-label="Close cart"><Icon name="close" size={22} /></button>
  </header>
  <ul class="items" data-items></ul>
  <p class="empty" data-empty hidden>Your cart is empty.</p>
  <footer>
    <p class="sum"><span>Subtotal</span><b data-total>$0</b></p>
    <p class="note">Taxes are calculated at checkout. Files are available instantly after payment.</p>
    <a class="btn" href="#">Checkout <Icon name="arrow" size={18} /></a>
    <button class="btn ghost" type="button" data-close-cart>Continue shopping</button>
  </footer>
</aside>

<style>
  .scrim {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgb(0 0 0 / 0.6);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .scrim.on {
    opacity: 1;
  }
  .drawer {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: 210;
    display: flex;
    flex-direction: column;
    width: min(440px, 100%);
    border-left: 1px solid var(--line);
    background: var(--s1);
    box-shadow: -24px 0 60px -20px rgb(0 0 0 / 0.8);
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.4s var(--ease), visibility 0s 0.4s;
  }
  .drawer.open {
    transform: none;
    visibility: visible;
    transition-delay: 0s;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
  }
  h2 {
    margin: 0;
    font-size: 1.25rem;
  }
  h2 span {
    margin-left: 6px;
    padding: 2px 9px;
    border-radius: 99px;
    background: var(--s3);
    font-size: 0.85rem;
  }
  .x {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    transition: background 0.15s;
  }
  .x:hover {
    background: var(--s3);
  }
  .items {
    flex: 1;
    margin: 0;
    padding: 8px 20px;
    list-style: none;
    overflow-y: auto;
  }
  .items :global(li) {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    animation: slide 0.35s var(--ease);
  }
  @keyframes slide {
    from {
      opacity: 0;
      transform: translateX(24px);
    }
  }
  .items :global(.ico) {
    display: grid;
    place-items: center;
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 10px;
    background: var(--s3);
    color: var(--acc);
  }
  .items :global(.txt) {
    display: grid;
    flex: 1;
    min-width: 0;
  }
  .items :global(.txt small) {
    color: var(--mut);
  }
  .items :global(.p) {
    font-weight: 700;
  }
  .items :global(button) {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--mut);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .items :global(button:hover) {
    background: var(--s3);
    color: var(--sale);
  }
  .empty {
    margin: 0;
    padding: 32px 20px;
    color: var(--mut);
    text-align: center;
  }
  footer {
    display: grid;
    gap: 10px;
    padding: 18px 20px 22px;
    border-top: 1px solid var(--line);
  }
  .sum {
    display: flex;
    justify-content: space-between;
    margin: 0;
    font-size: 1.15rem;
  }
  .note {
    margin: 0 0 6px;
    color: var(--mut);
    font-size: 0.85rem;
  }
</style>

<script>
  const drawer = document.getElementById('m5-cart')!;
  const scrim = document.querySelector<HTMLElement>('.scrim')!;
  const list = drawer.querySelector<HTMLElement>('[data-items]')!;
  const empty = drawer.querySelector<HTMLElement>('[data-empty]')!;
  const total = drawer.querySelector<HTMLElement>('[data-total]')!;
  const counters = document.querySelectorAll<HTMLElement>('[data-cart-count]');
  const items: { title: string; price: number; kind: string }[] = [
    { title: 'Aeon Vase Collection', price: 14, kind: 'Printable set · STL, 3MF' },
    { title: 'Pivot Snapper', price: 0, kind: 'Free script · Blender, Maya' },
  ];
  let opener: HTMLElement | null = null;

  const icon =
    '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5"/></svg>';
  const trash =
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>';

  const render = () => {
    list.replaceChildren();
    items.forEach((it, i) => {
      const li = document.createElement('li');
      li.innerHTML = `<span class="ico">${icon}</span><span class="txt"><b></b><small></small></span><span class="p"></span><button type="button" aria-label="Remove">${trash}</button>`;
      li.querySelector('b')!.textContent = it.title;
      li.querySelector('small')!.textContent = it.kind;
      li.querySelector('.p')!.textContent = it.price === 0 ? 'Free' : `$${it.price}`;
      li.querySelector('button')!.addEventListener('click', () => {
        items.splice(i, 1);
        render();
      });
      list.append(li);
    });
    empty.hidden = items.length > 0;
    total.textContent = `$${items.reduce((s, it) => s + it.price, 0)}`;
    counters.forEach((c) => (c.textContent = String(items.length)));
  };

  const open = () => {
    scrim.hidden = false;
    requestAnimationFrame(() => scrim.classList.add('on'));
    drawer.removeAttribute('inert');
    drawer.setAttribute('aria-hidden', 'false');
    drawer.classList.add('open');
    drawer.querySelector<HTMLElement>('.x')!.focus();
  };
  const close = () => {
    scrim.classList.remove('on');
    drawer.classList.remove('open');
    drawer.setAttribute('inert', '');
    drawer.setAttribute('aria-hidden', 'true');
    setTimeout(() => (scrim.hidden = true), 300);
    opener?.focus();
  };

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const add = t.closest<HTMLElement>('[data-add]');
    if (add) {
      e.preventDefault();
      opener = add;
      items.push({ title: add.dataset.title!, price: Number(add.dataset.price), kind: add.dataset.kind || 'Digital product' });
      render();
      open();
    } else if (t.closest('[data-open-cart]')) {
      e.preventDefault();
      opener = t.closest<HTMLElement>('[data-open-cart]');
      open();
    } else if (t.closest('[data-close-cart]')) {
      close();
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer.classList.contains('open')) close();
  });
  render();
</script>
