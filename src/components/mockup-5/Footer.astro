---
const columns = [
  { title: 'Marketplace', links: ['Catalog', '3D models for printing', '3D models for games', 'Tools & add-ons', 'Free downloads'] },
  { title: 'Learn', links: ['Blog', 'Changelog', 'Printing guide'] },
  { title: 'Legal', links: ['Privacy policy', 'Terms of sale (offer)', 'Licences', 'Refunds & returns'] },
  { title: 'Help', links: ['Contacts', 'My downloads', 'Report a problem'] },
];
const socials = ['YouTube', 'Discord', 'Instagram', 'X'];
---

<footer class="ft">
  <div class="wrap top">
    <div class="cta">
      <h2>Never miss a drop.</h2>
      <p>One short email a week with new models and free downloads.</p>
      <form action="#" onsubmit="return false">
        <label class="sr" for="m5-mail">Email address</label>
        <input id="m5-mail" type="email" placeholder="Your email" autocomplete="email" />
        <button class="btn" type="submit">Subscribe</button>
      </form>
    </div>
    <div class="cols">
      {
        columns.map((c) => (
          <nav aria-label={c.title}>
            <h3>{c.title}</h3>
            <ul>
              {c.links.map((l) => <li><a href="#">{l}</a></li>)}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>
  <div class="wrap bottom">
    <p class="logo">TRmarket</p>
    <ul class="soc" aria-label="Social networks">
      {socials.map((s) => <li><a href="#">{s}</a></li>)}
    </ul>
    <p class="legal">
      © 2026 TRmarket · Sole proprietor Full Name · Reg. No. 000 000 000 · Tax ID 0000000000 · 00 Placeholder St., City, Country · hello@example.com
    </p>
  </div>
</footer>

<style>
  .ft {
    margin-top: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--line);
    background: var(--s1);
  }
  .top {
    display: grid;
    gap: 40px;
    padding-block: 48px 36px;
  }
  .cta h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    letter-spacing: -0.03em;
  }
  .cta p {
    margin: 6px 0 18px;
    color: var(--mut);
  }
  form {
    display: flex;
    gap: 8px;
    max-width: 440px;
  }
  input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    padding: 0 18px;
    border: 1px solid #3b3b42;
    border-radius: 99px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
  }
  input:focus {
    outline: 2px solid var(--acc);
    border-color: transparent;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 16px;
  }
  h3 {
    margin: 0 0 8px;
    font-size: 0.95rem;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-block;
    padding: 4px 0;
    color: var(--mut);
    text-decoration: none;
    transition: color 0.15s;
  }
  nav a:hover {
    color: var(--text);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
    padding-block: 20px 76px;
    border-top: 1px solid var(--line);
  }
  .logo {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .soc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .soc a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid #3b3b42;
    border-radius: 99px;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .soc a:hover {
    background: var(--s3);
    border-color: var(--text);
  }
  .legal {
    flex-basis: 100%;
    margin: 0;
    color: var(--mut);
    font-size: 0.85rem;
  }
  @media (min-width: 900px) {
    .top {
      grid-template-columns: 1fr 1.2fr;
      gap: 64px;
    }
    .cols {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
