---
import '@fontsource-variable/dm-sans';
import { href } from '../../data/products';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
  </head>
  <body class="m5">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="m5-cyl" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#000" stop-opacity="0.6" />
          <stop offset="0.2" stop-color="#000" stop-opacity="0.12" />
          <stop offset="0.34" stop-color="#fff" stop-opacity="0.3" />
          <stop offset="0.45" stop-color="#fff" stop-opacity="0" />
          <stop offset="0.72" stop-color="#000" stop-opacity="0.14" />
          <stop offset="1" stop-color="#000" stop-opacity="0.65" />
        </linearGradient>
      </defs>
    </svg>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <a class="back" href={href()} lang="ru">← к выбору макетов</a>
  </body>
</html>

<style is:global>
  .m5 {
    --bg: #0a0a0b;
    --s1: #131315;
    --s2: #1b1b1e;
    --s3: #252529;
    --line: #27272c;
    --text: #f4f4f5;
    --mut: #a1a1aa;
    --acc: #3ddc97;
    --acc-h: #62e8ae;
    --sale: #ff6b6b;
    --font: 'DM Sans Variable', system-ui, sans-serif;
    --wrap: min(1360px, 100% - clamp(24px, 5vw, 72px));
    --ease: cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .m5 {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 400 1rem/1.5 var(--font);
    -webkit-font-smoothing: antialiased;
  }
  .m5 *,
  .m5 *::before,
  .m5 *::after {
    box-sizing: border-box;
  }
  .m5 a {
    color: inherit;
  }
  .m5 button {
    font: inherit;
    color: inherit;
  }
  .m5 :focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 3px;
    border-radius: 6px;
  }
  .m5 .wrap {
    width: var(--wrap);
    margin-inline: auto;
  }
  .m5 .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .m5 .skip {
    position: fixed;
    inset: 8px auto auto 8px;
    z-index: 300;
    padding: 0.6rem 1rem;
    border-radius: 8px;
    background: var(--acc);
    color: #04210f;
    font-weight: 700;
    transform: translateY(-200%);
  }
  .m5 .skip:focus {
    transform: none;
  }
  .m5 .back {
    position: fixed;
    inset: auto auto 14px 14px;
    z-index: 90;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: rgb(27 27 30 / 0.95);
    font: 500 0.78rem system-ui, sans-serif;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .m5 .back:hover {
    border-color: var(--acc);
  }
  .m5 .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 48px;
    padding: 0 1.4rem;
    border: 0;
    border-radius: 99px;
    background: var(--acc);
    color: #04210f;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s, transform 0.2s var(--ease), box-shadow 0.2s;
  }
  .m5 .btn:hover {
    background: var(--acc-h);
    box-shadow: 0 8px 24px -8px rgb(61 220 151 / 0.55);
  }
  .m5 .btn:active {
    transform: scale(0.97);
  }
  .m5 .btn.ghost {
    background: transparent;
    color: var(--text);
    box-shadow: inset 0 0 0 1px #3b3b42;
  }
  .m5 .btn.ghost:hover {
    background: var(--s3);
    box-shadow: inset 0 0 0 1px var(--text);
  }
  .m5 .sec {
    margin-top: clamp(3rem, 6vw, 5.5rem);
  }
  .m5 .sec-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .m5 h2.t {
    margin: 0;
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .m5 .sub {
    margin: 4px 0 0;
    color: var(--mut);
  }
  .m5 .link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .m5 .link:hover {
    color: var(--acc-h);
  }
  @media (prefers-reduced-motion: reduce) {
    .m5 * {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>
