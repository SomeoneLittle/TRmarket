---
import { popularProducts } from '../../data/products';
import Card from './Card.astro';
import Icon from './Icon.astro';
---

<section class="pop" aria-labelledby="m2-pop">
  <div class="wrap">
    <header class="head">
      <h2 id="m2-pop" class="stitle"><small>03 / Ranked by pulls</small>Popular right now</h2>
      <a class="btn ghost" href="#">View all <Icon name="arrow" size={18} /></a>
    </header>
    <ul class="grid">
      {
        popularProducts.map((p) => (
          <li>
            <Card product={p} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .pop {
    margin-top: clamp(5rem, 10vw, 8rem);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }
  .grid {
    display: grid;
    gap: 1rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }
  .grid > li {
    display: flex;
  }
  .grid > li > :global(.pcard) {
    flex: 1;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1020px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
</style>
