---
import { categoryName, formatCount, freeProducts } from '../../data/products';
import Art from './Art.astro';
import Icon from './Icon.astro';

const axisColor = { print: 'var(--x)', game: 'var(--y)', tool: 'var(--z)' };
---

<section class="free" id="free" aria-labelledby="m2-free">
  <div class="wrap">
    <h2 id="m2-free" class="stitle"><small>02 / Outliner</small>Free assets</h2>
    <div class="layout">
      <div class="outliner brk">
        <p class="coll mono"><span aria-hidden="true">▾</span> Collection · FREE_ASSETS <b>({freeProducts.length})</b></p>
        <ul>
          {
            freeProducts.map((p) => (
              <li style={`--ax:${axisColor[p.category]}`}>
                <a class="row" href="#">
                  <span class="thumb" aria-hidden="true">
                    <Art profile={p.profile} category={p.category} label="" />
                  </span>
                  <span class="txt">
                    <span class="name">{p.title}</span>
                    <span class="mono sub">
                      {categoryName(p.category)} · {p.formats.join(' / ')} · {p.spec}
                    </span>
                  </span>
                  <span class="dl mono"><Icon name="download" size={14} /> {formatCount(p.downloads)}</span>
                  <span class="get mono">Get<Icon name="arrow" size={14} /></span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="props brk" aria-label="Licence terms for free assets">
        <p class="mono ph">Properties · Licence</p>
        <dl class="mono">
          <div><dt>Price</dt><dd class="lime">$0.00</dd></div>
          <div><dt>Commercial use</dt><dd>Allowed</dd></div>
          <div><dt>Attribution</dt><dd>Not required</dd></div>
          <div><dt>Resale as-is</dt><dd>Not allowed</dd></div>
          <div><dt>Updates</dt><dd>Lifetime</dd></div>
        </dl>
        <a class="btn ghost" href="#">Read the licence</a>
      </aside>
    </div>
  </div>
</section>

<style>
  .free {
    margin-top: clamp(5rem, 10vw, 8rem);
  }
  .layout {
    display: grid;
    gap: 1rem;
    margin-top: 1.75rem;
  }
  .coll {
    margin: 0;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--cyan);
    text-transform: uppercase;
  }
  .coll b {
    color: var(--dim);
    font-weight: 500;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    grid-template-areas: 'thumb txt get' 'thumb dl get';
    align-items: center;
    gap: 0.15rem 1rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--line);
    border-left: 2px solid transparent;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }
  li:last-child .row {
    border-bottom: 0;
  }
  .row:hover {
    background: color-mix(in srgb, var(--ax) 10%, transparent);
    border-left-color: var(--ax);
  }
  .row:active {
    background: color-mix(in srgb, var(--ax) 20%, transparent);
  }
  .thumb {
    grid-area: thumb;
    display: block;
    width: 72px;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    background: var(--bg);
  }
  .txt {
    grid-area: txt;
    display: grid;
    min-width: 0;
  }
  .name {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .sub {
    color: var(--dim);
    font-size: 0.7rem;
  }
  .dl {
    grid-area: dl;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--dim);
  }
  .get {
    grid-area: get;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 1px solid var(--ax);
    color: var(--ax);
    text-transform: uppercase;
  }
  .row:hover .get {
    background: var(--ax);
    color: #000;
  }
  .props {
    padding: 1rem 1.1rem 1.2rem;
    align-self: start;
  }
  .ph {
    margin: 0 0 0.75rem;
    color: var(--cyan);
    text-transform: uppercase;
  }
  dl {
    display: grid;
    gap: 0.45rem;
    margin: 0 0 1.25rem;
  }
  dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px dashed var(--line);
  }
  dt {
    color: var(--dim);
  }
  dd {
    margin: 0;
  }
  .lime {
    color: var(--lime);
  }
  .props .btn {
    width: 100%;
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 1fr 320px;
      gap: 1.25rem;
    }
  }
  @media (max-width: 520px) {
    .row {
      grid-template-columns: 56px 1fr;
      grid-template-areas: 'thumb txt' 'thumb dl' 'get get';
    }
    .thumb {
      width: 56px;
    }
    .get {
      justify-content: center;
      margin-top: 0.4rem;
    }
  }
</style>
