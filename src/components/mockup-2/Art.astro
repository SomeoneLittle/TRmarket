---
import { PROFILES, type Category, type ProfileName } from '../../data/products';

interface Props {
  profile: ProfileName;
  category: Category;
  label: string;
}
const { profile, category, label } = Astro.props;

const color = { print: 'var(--x)', game: 'var(--y)', tool: 'var(--z)' }[category];
const prof = PROFILES[profile];
const N = prof.length;
const CX = 120;
const BASE = 188;
const H = 124;
const R = 86;
const TILT = 0.3;

const rings = prof.map((r, i) => ({ rx: r * R, ry: r * R * TILT, y: BASE - (i * H) / (N - 1) }));
const angles = Array.from({ length: 8 }, (_, k) => (k * Math.PI) / 4);
const meridians = angles.map((a) => {
  const pts = rings.map((g) => `${(CX + Math.cos(a) * g.rx).toFixed(1)} ${(g.y + Math.sin(a) * g.ry).toFixed(1)}`);
  return { d: `M${pts.join('L')}`, front: Math.sin(a) >= 0 };
});
const dots = rings.flatMap((g, i) =>
  i % 3 === 1
    ? angles.map((a) => ({ x: CX + Math.cos(a) * g.rx, y: g.y + Math.sin(a) * g.ry }))
    : [],
);
---

<svg
  viewBox="0 0 240 220"
  class="wire"
  style={`--c:${color}`}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <g fill="none" stroke="var(--c)" stroke-width="1">
    {rings.map((g) => <ellipse cx={CX} cy={g.y} rx={Math.max(g.rx, 0.6)} ry={Math.max(g.ry, 0.2)} opacity="0.55" />)}
    {meridians.map((m) => <path d={m.d} opacity={m.front ? 0.85 : 0.28} />)}
  </g>
  <g class="dots" fill="var(--c)">
    {dots.map((d) => <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r="1.8" />)}
  </g>
</svg>

<style>
  .wire {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--c) 45%, transparent));
  }
  .dots {
    opacity: 0;
    transition: opacity 0.25s;
  }
  :global(.pcard:hover) .dots,
  :global(.cat:hover) .dots,
  :global(.pcard:focus-within) .dots {
    opacity: 1;
  }
</style>
