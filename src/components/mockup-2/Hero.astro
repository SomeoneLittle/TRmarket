---
import { PROFILES } from '../../data/products';
import Icon from './Icon.astro';

const prof = PROFILES.helmet;
const N = prof.length;
const yAt = (i: number) => 0.94 - (0.88 * i) / (N - 1); // fraction from the top of the cube
const rings = prof.map((r, i) => ({ r, y: yAt(i) }));
const right = prof.map((r, i) => `${(50 + r * 50).toFixed(2)} ${(yAt(i) * 100).toFixed(2)}`);
const left = prof.map((r, i) => `${(50 - r * 50).toFixed(2)} ${(yAt(i) * 100).toFixed(2)}`);
const outline = `M${right.join('L')}M${left.join('L')}`;
const panels = [0, 45, 90, 135];
const formats = ['FBX', 'GLB', 'STL', '3MF', 'BLEND'];
---

<section class="hero" aria-labelledby="m2-h1">
  <div class="wrap grid">
    <div class="copy">
      <p class="mono eyebrow"><span class="ping"></span>TRmarket / Scene · 3D assets &amp; tools</p>
      <h1 id="m2-h1">Clean topology,<br /><em>zero</em> guesswork.</h1>
      <p class="lead">
        3D models for printing and games, plus the brushes, add-ons and scripts to sculpt your own. One author, every
        file tested.
      </p>
      <div class="cta">
        <a class="btn" href="#cats">Open the catalog <Icon name="arrow" size={18} /></a>
        <a class="btn ghost" href="#free">Free assets</a>
      </div>
      <ul class="fmts" aria-label="Supported formats">
        {formats.map((f) => <li class="mono">{f}</li>)}
      </ul>
    </div>

    <div class="vp brk" aria-hidden="true">
      <div class="floor"><div class="floor-in"></div></div>
      <p class="hud tl mono">User Perspective<br /><span>(1) Scene | Sentinel_Helmet_01</span></p>
      <p class="hud bl mono">
        Verts <b>6,240</b> · Faces <b>6,180</b> · Tris <b>12,360</b>
      </p>

      <svg class="gizmo" viewBox="0 0 80 80" focusable="false">
        <g stroke-width="2.4" stroke-linecap="round">
          <line x1="40" y1="40" x2="68" y2="40" stroke="var(--x)"></line>
          <line x1="40" y1="40" x2="40" y2="12" stroke="var(--y)"></line>
          <line x1="40" y1="40" x2="20" y2="60" stroke="var(--z)"></line>
        </g>
        <g font-family="monospace" font-size="9" font-weight="700" text-anchor="middle">
          <circle cx="68" cy="40" r="8" fill="var(--x)"></circle><text x="68" y="43" fill="#000">X</text>
          <circle cx="40" cy="12" r="8" fill="var(--y)"></circle><text x="40" y="15" fill="#000">Y</text>
          <circle cx="20" cy="60" r="8" fill="var(--z)"></circle><text x="20" y="63" fill="#000">Z</text>
        </g>
      </svg>

      <div class="scene">
        <div class="obj">
          {
            rings.map((g) => (
              <i class="ring" style={`--r:${g.r};--y:${g.y}`}></i>
            ))
          }
          {
            panels.map((a) => (
              <svg class="mer" viewBox="0 0 100 100" style={`--a:${a}deg`} focusable="false">
                <path d={outline} fill="none" stroke="var(--cyan)" stroke-width="0.5" vector-effect="non-scaling-stroke"></path>
              </svg>
            ))
          }
        </div>
        <span class="bb"></span>
      </div>

      <div class="tl-bar">
        <div class="ruler"><span class="head"></span></div>
        <p class="mono frames"><span>001</span><span>060</span><span>120</span><span>180</span><span>240</span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1.5rem, 4vw, 3.5rem) 0;
  }
  .grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.25rem;
    color: var(--cyan);
    text-transform: uppercase;
  }
  .ping {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 10px var(--lime);
    animation: ping 2s ease-in-out infinite;
  }
  @keyframes ping {
    50% {
      opacity: 0.3;
    }
  }
  h1 {
    margin: 0;
    font: 600 clamp(2.6rem, 6.4vw, 5.4rem)/1.02 var(--sans);
    letter-spacing: -0.035em;
  }
  h1 em {
    color: var(--lime);
    font-style: normal;
    text-shadow: 0 0 30px rgb(198 255 63 / 0.35);
  }
  .lead {
    max-width: 33rem;
    margin: 1.5rem 0;
    color: var(--dim);
    font-size: 1.15rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .fmts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .fmts li {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--line-2);
    color: var(--dim);
  }

  /* Viewport */
  .vp {
    position: relative;
    aspect-ratio: 4 / 3.4;
    overflow: hidden;
    perspective: 1100px;
    background: radial-gradient(ellipse at 50% 35%, #0f1c2b 0%, var(--panel) 62%);
  }
  .floor {
    position: absolute;
    inset: 42% -40% -30%;
    overflow: hidden;
    transform: perspective(520px) rotateX(64deg);
    transform-origin: 50% 0;
    mask-image: radial-gradient(ellipse 60% 70% at 50% 25%, #000 25%, transparent 75%);
  }
  .floor-in {
    position: absolute;
    inset: -60px 0 0;
    background:
      linear-gradient(var(--line-2) 1px, transparent 1px) 0 0 / 60px 60px,
      linear-gradient(90deg, var(--line-2) 1px, transparent 1px) 0 0 / 60px 60px;
    animation: drift 4s linear infinite;
  }
  @keyframes drift {
    to {
      transform: translateY(60px);
    }
  }
  .hud {
    position: absolute;
    z-index: 2;
    margin: 0;
    color: var(--dim);
    font-size: 0.68rem;
    line-height: 1.5;
  }
  .hud span,
  .hud b {
    color: var(--text);
    font-weight: 500;
  }
  .tl {
    inset: 0.8rem auto auto 0.9rem;
  }
  .bl {
    inset: auto auto 3.2rem 0.9rem;
  }
  .gizmo {
    position: absolute;
    inset: 0.7rem 0.7rem auto auto;
    width: 76px;
    z-index: 2;
  }
  .scene {
    --s: clamp(190px, 28vw, 330px);
    position: absolute;
    left: 50%;
    top: 46%;
    width: var(--s);
    height: var(--s);
    margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    transform-style: preserve-3d;
  }
  .obj {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(-16deg) rotateY(0deg);
    animation: spin 26s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotateX(-16deg) rotateY(360deg);
    }
  }
  .ring {
    position: absolute;
    left: 50%;
    top: calc(var(--s) * var(--y));
    width: calc(var(--s) * var(--r));
    height: calc(var(--s) * var(--r));
    border: 1px solid var(--cyan);
    border-radius: 50%;
    opacity: 0.6;
    transform: translate(-50%, -50%) rotateX(90deg);
  }
  .mer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: rotateY(var(--a));
    filter: drop-shadow(0 0 5px rgb(77 228 255 / 0.6));
  }
  .bb {
    position: absolute;
    inset: -6% -10%;
    pointer-events: none;
    --c: var(--lime);
    --l: 18px;
    background:
      linear-gradient(var(--c), var(--c)) 0 0 / var(--l) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) 0 0 / 2px var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 0 / var(--l) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 0 / 2px var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) 0 100% / var(--l) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) 0 100% / 2px var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 100% / var(--l) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 100% / 2px var(--l) no-repeat;
    opacity: 0.8;
  }
  .tl-bar {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    padding: 0.4rem 0.9rem 0.5rem;
    border-top: 1px solid var(--line);
    background: rgb(6 8 12 / 0.7);
  }
  .ruler {
    position: relative;
    height: 12px;
    background: repeating-linear-gradient(90deg, var(--line-2) 0 1px, transparent 1px 12px);
  }
  .head {
    position: absolute;
    top: -2px;
    left: 0;
    width: 2px;
    height: 16px;
    background: var(--lime);
    box-shadow: 0 0 8px var(--lime);
    animation: play 9s linear infinite;
  }
  @keyframes play {
    to {
      left: 100%;
    }
  }
  .frames {
    display: flex;
    justify-content: space-between;
    margin: 0.2rem 0 0;
    color: var(--dim);
    font-size: 0.62rem;
  }

  @media (min-width: 980px) {
    .grid {
      grid-template-columns: 1fr 1.05fr;
      gap: 3rem;
    }
  }
  @media (max-width: 520px) {
    .bl {
      display: none;
    }
    .vp {
      aspect-ratio: 4 / 4.2;
    }
  }
</style>
