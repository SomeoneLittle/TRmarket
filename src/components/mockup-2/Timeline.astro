---
import { categoryName, formatPrice, freshProducts } from '../../data/products';
import Art from './Art.astro';

const axisColor = { print: 'var(--x)', game: 'var(--y)', tool: 'var(--z)' };
---

<section class="tl" aria-labelledby="m2-tl">
  <div class="wrap">
    <h2 id="m2-tl" class="stitle"><small>04 / Timeline</small>New in the last 30 hours</h2>
    <ol class="track">
      {
        freshProducts.map((p) => (
          <li style={`--ax:${axisColor[p.category]}`}>
            <span class="key mono"><i aria-hidden="true"></i>−{p.addedHours}h</span>
            <a class="item brk" href="#">
              <span class="pic" aria-hidden="true">
                <Art profile={p.profile} category={p.category} label="" />
              </span>
              <span class="name">{p.title}</span>
              <span class="meta mono">
                {categoryName(p.category)} · {formatPrice(p.price)}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .tl {
    margin-top: clamp(5rem, 10vw, 8rem);
  }
  .track {
    display: grid;
    gap: 1.25rem;
    margin: 2rem 0 0;
    padding: 0 0 0 1.25rem;
    border-left: 1px solid var(--line-2);
    list-style: none;
  }
  li {
    position: relative;
  }
  .key {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
    color: var(--ax);
  }
  .key i {
    position: absolute;
    inset: 0.2rem auto auto -1.25rem;
    width: 9px;
    height: 9px;
    background: var(--ax);
    box-shadow: 0 0 10px var(--ax);
    transform: translateX(-4px) rotate(45deg);
  }
  .item {
    --bc: var(--ax);
    display: grid;
    grid-template-columns: 76px 1fr;
    grid-template-areas: 'pic name' 'pic meta';
    align-items: center;
    gap: 0 1rem;
    padding: 0.8rem;
    text-decoration: none;
    transition: border-color 0.25s, background 0.25s;
  }
  .item:hover {
    border-color: var(--ax);
    background: color-mix(in srgb, var(--ax) 8%, var(--panel));
  }
  .item:hover::after {
    inset: 4px;
  }
  .item:active {
    background: color-mix(in srgb, var(--ax) 18%, var(--panel));
  }
  .pic {
    grid-area: pic;
    width: 76px;
    aspect-ratio: 1;
  }
  .name {
    grid-area: name;
    align-self: end;
    font-weight: 600;
    line-height: 1.25;
  }
  .meta {
    grid-area: meta;
    align-self: start;
    color: var(--dim);
  }
  @media (min-width: 980px) {
    .track {
      grid-template-columns: repeat(5, 1fr);
      gap: 1rem;
      padding: 1.25rem 0 0;
      border-left: 0;
      border-top: 1px solid var(--line-2);
    }
    .key i {
      inset: -1.65rem auto auto 0;
      transform: rotate(45deg);
    }
    .item {
      grid-template-columns: 1fr;
      grid-template-areas: 'pic' 'name' 'meta';
      justify-items: start;
      gap: 0.25rem;
      height: 100%;
    }
    .pic {
      width: 100%;
      aspect-ratio: 1.1;
    }
  }
</style>
