---
import { categories, products } from '../../data/products';
import Art from './Art.astro';
import Icon from './Icon.astro';

const meta = {
  print: { axis: 'X', color: 'var(--x)', pick: 'vase' },
  game: { axis: 'Y', color: 'var(--y)', pick: 'helmet' },
  tool: { axis: 'Z', color: 'var(--z)', pick: 'brush' },
} as const;
---

<section class="cats" id="cats" aria-labelledby="m2-cats">
  <div class="wrap">
    <h2 id="m2-cats" class="stitle"><small>01 / Collections</small>Three axes of work</h2>
    <ul class="grid">
      {
        categories.map((c) => {
          const m = meta[c.id];
          const p = products.find((x) => x.profile === m.pick)!;
          return (
            <li>
              <a class="cat brk" href="#" style={`--bc:${m.color};--ax:${m.color}`}>
                <span class="top mono">
                  <span class="axis">{m.axis}</span>
                  <span>{String(c.count).padStart(2, '0')} objects</span>
                </span>
                <span class="art" aria-hidden="true">
                  <Art profile={p.profile} category={c.id} label="" />
                </span>
                <span class="name">{c.name}</span>
                <span class="blurb">{c.blurb}</span>
                <span class="go mono">
                  Enter collection <Icon name="arrow" size={16} />
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .cats {
    margin-top: clamp(4rem, 9vw, 7rem);
  }
  .grid {
    display: grid;
    gap: 1rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .cat {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
    height: 100%;
    padding: 1rem;
    text-decoration: none;
    transition: border-color 0.25s, background 0.25s, transform 0.25s;
  }
  .cat:hover {
    border-color: var(--ax);
    background: linear-gradient(180deg, color-mix(in srgb, var(--ax) 9%, var(--panel)), var(--panel));
  }
  .cat:hover::after {
    inset: 6px;
  }
  .cat:active {
    transform: scale(0.99);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--dim);
    text-transform: uppercase;
  }
  .axis {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid var(--ax);
    border-radius: 50%;
    color: var(--ax);
    font-weight: 700;
  }
  .art {
    display: block;
    aspect-ratio: 240 / 190;
    margin: 0.4rem 0 0.2rem;
  }
  .name {
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .blurb {
    color: var(--dim);
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.7rem;
    color: var(--ax);
    text-transform: uppercase;
  }
  .cat:hover .go :global(svg) {
    transform: translateX(4px);
  }
  .go :global(svg) {
    transition: transform 0.25s;
  }
  @media (min-width: 820px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
    li:nth-child(2) .cat {
      transform: translateY(1.5rem);
    }
    li:nth-child(2) .cat:active {
      transform: translateY(1.5rem) scale(0.99);
    }
  }
</style>
