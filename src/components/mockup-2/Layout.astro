---
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import { href } from '../../data/products';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06080c" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
  </head>
  <body class="m2">
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <a class="back" href={href()} lang="ru">← к выбору макетов</a>
  </body>
</html>

<style is:global>
  .m2 {
    --bg: #06080c;
    --panel: #0b1017;
    --panel-2: #111a26;
    --line: rgb(110 190 255 / 0.16);
    --line-2: rgb(110 190 255 / 0.36);
    --text: #dbe7f1;
    --dim: #93a6b8;
    --cyan: #4de4ff;
    --lime: #c6ff3f;
    --x: #ff5b6e;
    --y: #7cff7c;
    --z: #5aa8ff;
    --mono: 'JetBrains Mono Variable', ui-monospace, monospace;
    --sans: 'IBM Plex Sans', system-ui, sans-serif;
    --wrap: min(1400px, 100% - clamp(32px, 6vw, 72px));
  }
  .m2 {
    margin: 0;
    background: radial-gradient(rgb(110 190 255 / 0.1) 1px, transparent 1px) 0 0 / 24px 24px, var(--bg);
    color: var(--text);
    font-family: var(--sans);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .m2 *,
  .m2 *::before,
  .m2 *::after {
    box-sizing: border-box;
  }
  .m2 a {
    color: inherit;
  }
  .m2 :focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 3px;
  }
  .m2 .wrap {
    width: var(--wrap);
    margin-inline: auto;
  }
  .m2 .mono {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
  .m2 .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .m2 .skip {
    position: fixed;
    inset: 8px auto auto 8px;
    z-index: 100;
    padding: 0.7rem 1rem;
    background: var(--lime);
    color: #000;
    font-weight: 600;
    transform: translateY(-200%);
  }
  .m2 .skip:focus {
    transform: none;
  }
  .m2 .back {
    position: fixed;
    inset: auto auto 14px 14px;
    z-index: 90;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--line-2);
    background: rgb(6 8 12 / 0.88);
    backdrop-filter: blur(6px);
    color: var(--text);
    font-family: system-ui, sans-serif;
    font-size: 0.72rem;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .m2 .back:hover {
    border-color: var(--lime);
    color: var(--lime);
  }
  .m2 .back:active {
    background: var(--lime);
    color: #000;
  }
  /* Corner brackets: the shared panel motif */
  .m2 .brk {
    position: relative;
    border: 1px solid var(--line);
    background: var(--panel);
    transition: border-color 0.25s;
  }
  .m2 .brk::after {
    content: '';
    position: absolute;
    inset: -1px;
    pointer-events: none;
    --c: var(--bc, var(--cyan));
    --l: 12px;
    background:
      linear-gradient(var(--c), var(--c)) 0 0 / var(--l) 1px no-repeat,
      linear-gradient(var(--c), var(--c)) 0 0 / 1px var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 0 / var(--l) 1px no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 0 / 1px var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) 0 100% / var(--l) 1px no-repeat,
      linear-gradient(var(--c), var(--c)) 0 100% / 1px var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 100% / var(--l) 1px no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 100% / 1px var(--l) no-repeat;
    transition: inset 0.25s;
  }
  .m2 .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 46px;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--lime);
    background: var(--lime);
    color: #06100a;
    font: 600 0.9rem/1 var(--mono);
    text-decoration: none;
    cursor: pointer;
    transition: box-shadow 0.2s, background 0.2s, color 0.2s, transform 0.2s;
  }
  .m2 .btn:hover {
    box-shadow: 0 0 0 3px rgb(198 255 63 / 0.25), 0 0 28px rgb(198 255 63 / 0.35);
  }
  .m2 .btn:active {
    transform: translateY(1px);
    background: #a8e029;
  }
  .m2 .btn.ghost {
    background: transparent;
    color: var(--text);
    border-color: var(--line-2);
  }
  .m2 .btn.ghost:hover {
    border-color: var(--cyan);
    color: var(--cyan);
    box-shadow: 0 0 22px rgb(77 228 255 / 0.2);
  }
  .m2 .btn.ghost:active {
    background: rgb(77 228 255 / 0.12);
  }
  .m2 .stitle {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    margin: 0;
    font: 600 clamp(1.5rem, 3.4vw, 2.4rem)/1.1 var(--sans);
    letter-spacing: -0.02em;
  }
  .m2 .stitle small {
    color: var(--cyan);
    font: 500 0.78rem/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (prefers-reduced-motion: reduce) {
    .m2 * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
