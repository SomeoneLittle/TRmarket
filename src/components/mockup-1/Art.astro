---
import { PROFILES, type ProfileName } from '../../data/products';

interface Props {
  profile: ProfileName;
  tone: number;
  label: string;
}
const { profile, tone, label } = Astro.props;

const LAYERS = 24;
const R = 78;
const fills = ['var(--yellow)', 'var(--orange)', 'var(--blue)', 'var(--mint)'];
const prof = PROFILES[profile];
const radiusAt = (t: number) => {
  const x = t * (prof.length - 1);
  const i = Math.floor(x);
  const f = x - i;
  return prof[i] * (1 - f) + prof[Math.min(i + 1, prof.length - 1)] * f;
};
const layers = Array.from({ length: LAYERS }, (_, i) => {
  const rx = Math.max(radiusAt(i / (LAYERS - 1)) * R, 2);
  return { rx, ry: rx * 0.5, cy: 160 - i * 4.7 };
});
---

<svg
  viewBox="0 0 200 200"
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  class="art"
>
  <ellipse cx="108" cy="168" rx={layers[0].rx} ry={layers[0].ry} fill="var(--ink)"></ellipse>
  {
    layers.map((l, i) => (
      <ellipse
        cx="100"
        cy={l.cy}
        rx={l.rx}
        ry={l.ry}
        fill={fills[tone]}
        stroke="var(--ink)"
        stroke-width="1.8"
        style={`--i:${i}`}
      />
    ))
  }
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    height: 100%;
  }
  ellipse {
    transition: transform 0.2s steps(3);
    transform-box: fill-box;
    transform-origin: center;
  }
  :global(.card:hover) ellipse:nth-child(n + 3):nth-child(odd) {
    transform: translateX(3px);
  }
  :global(.card:hover) ellipse:nth-child(n + 3):nth-child(even) {
    transform: translateX(-3px);
  }
  @media (prefers-reduced-motion: reduce) {
    ellipse {
      transition: none;
    }
    :global(.card:hover) ellipse {
      transform: none !important;
    }
  }
</style>
