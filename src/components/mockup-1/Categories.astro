---
import { categories, products } from '../../data/products';
import Art from './Art.astro';
import Icon from './Icon.astro';

const colors = ['var(--yellow)', 'var(--blue)', 'var(--orange)'];
const textColors = ['var(--ink)', '#fff', 'var(--ink)'];
const sample = categories.map((c) => products.find((p) => p.category === c.id)!);
---

<section class="cats" id="catalog" aria-labelledby="m1-cats">
  <div class="wrap">
    <h2 id="m1-cats" class="section-title">Pick a<br />material</h2>
    <ul class="grid">
      {
        categories.map((c, i) => (
          <li style={`--c:${colors[i]};--t:${textColors[i]}`}>
            <a class="slab" href="#">
              <span class="num">0{i + 1}</span>
              <span class="art" aria-hidden="true">
                <Art profile={sample[i].profile} tone={[0, 2, 1][i]} label="" />
              </span>
              <span class="txt">
                <span class="name">{c.name}</span>
                <span class="blurb">{c.blurb}</span>
                <span class="mono count">{c.count} files in stock</span>
              </span>
              <span class="arrow" aria-hidden="true"><Icon name="arrow" size={28} /></span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cats {
    margin-top: clamp(3.5rem, 9vw, 7rem);
  }
  .grid {
    display: grid;
    gap: 1.75rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .slab {
    position: relative;
    display: grid;
    min-height: 300px;
    align-content: space-between;
    overflow: hidden;
    padding: 1.25rem;
    border: var(--bw) solid var(--ink);
    background: var(--c);
    color: var(--t);
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--ink), 8px 8px 0 var(--paper), 12px 12px 0 var(--ink);
    transition: transform 0.12s steps(3), box-shadow 0.12s steps(3);
  }
  .slab:hover {
    transform: translate(-6px, -6px);
    box-shadow:
      4px 4px 0 var(--ink),
      8px 8px 0 var(--paper),
      12px 12px 0 var(--ink),
      16px 16px 0 var(--paper),
      20px 20px 0 var(--ink),
      24px 24px 0 var(--paper),
      28px 28px 0 var(--ink);
  }
  .slab:active {
    transform: translate(4px, 4px);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .num {
    font: 700 clamp(4rem, 9vw, 6.5rem)/0.8 var(--font);
    letter-spacing: -0.06em;
    -webkit-text-stroke: 3px var(--ink);
    color: transparent;
  }
  .slab:nth-child(2) .num {
    -webkit-text-stroke-color: #fff;
  }
  .art {
    position: absolute;
    inset: auto -8% -14% auto;
    width: 62%;
    aspect-ratio: 1;
    opacity: 0.95;
  }
  .txt {
    position: relative;
    display: grid;
    gap: 0.35rem;
    max-width: 62%;
  }
  .name {
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .blurb {
    font-size: 0.95rem;
  }
  .count {
    margin-top: 0.4rem;
    font-size: 0.7rem;
  }
  .arrow {
    position: absolute;
    inset: 1rem 1rem auto auto;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: var(--bw) solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }
  .slab:hover .arrow {
    background: var(--ink);
    color: var(--paper);
  }
  @media (min-width: 860px) {
    .grid {
      grid-template-columns: 1.35fr 1fr 1fr;
    }
    .slab {
      min-height: 420px;
    }
    li:nth-child(2) .slab {
      margin-top: 2rem;
    }
    li:nth-child(3) .slab {
      margin-top: 4rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .slab {
      transition: none;
    }
  }
</style>
