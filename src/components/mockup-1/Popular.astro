---
import { popularProducts } from '../../data/products';
import ProductCard from './ProductCard.astro';
import Icon from './Icon.astro';
---

<section class="pop" aria-labelledby="m1-pop">
  <div class="wrap">
    <header class="head">
      <h2 id="m1-pop" class="section-title">Most<br />downloaded</h2>
      <a class="btn alt" href="#">See all <Icon name="arrow" size={20} /></a>
    </header>
    <ul class="grid">
      {
        popularProducts.map((p, i) => (
          <li>
            <ProductCard product={p} rank={i + 1} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .pop {
    margin-top: clamp(4rem, 10vw, 8rem);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }
  .grid {
    display: grid;
    gap: 2rem 1.75rem;
    margin: 2.25rem 0 0;
    padding: 0 9px 9px 0;
    list-style: none;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
    li:nth-child(3n + 2) {
      margin-top: 2.5rem;
    }
    li:nth-child(3n) {
      margin-top: 5rem;
    }
  }
  .grid > li {
    display: flex;
  }
  .grid > li > :global(.card) {
    flex: 1;
  }
</style>
