---
import { categoryName, formatCount, formatPrice, type Product } from '../../data/products';
import Art from './Art.astro';
import Icon from './Icon.astro';

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const free = p.price === 0;
const off = p.oldPrice ? Math.round((1 - p.price / p.oldPrice) * 100) : 0;
const model = p.category !== 'tool';
---

<article
  class="card"
  data-cat={p.category}
  data-price={p.price}
  data-rating={p.rating}
  data-dl={p.downloads}
  data-added={p.addedHours}
  data-formats={p.formats.map((f) => f.toLowerCase()).join('|')}
>
  <div class="thumb" data-view="render" data-hover={model ? '' : undefined}>
    <Art product={p} label={`Preview of ${p.title}`} />
    <div class="badges">
      {p.addedHours <= 30 && <span class="b new">New</span>}
      {off > 0 && <span class="b sale">−{off}%</span>}
      {free && <span class="b free">Free</span>}
    </div>
    <button class="fav" type="button" data-fav aria-pressed="false" aria-label={`Add ${p.title} to favorites`}><Icon name="heart" size={17} /></button>
    {
      model && (
        <div class="dots" aria-hidden="true">
          <i></i><i></i><i></i>
        </div>
      )
    }
  </div>
  <div class="body">
    <p class="cat">{categoryName(p.category)} · {p.formats.join(', ')}</p>
    <h3><a href="#">{p.title}</a></h3>
    <p class="desc">{p.blurb}</p>
    <p class="rate"><Icon name="star" size={14} /> <b>{p.rating.toFixed(1)}</b> <span>({p.reviews})</span> <span class="dl"><Icon name="download" size={14} /> {formatCount(p.downloads)}</span></p>
    <div class="buy">
      <p class="price"><b>{formatPrice(p.price)}</b>{p.oldPrice && <s>${p.oldPrice}</s>}</p>
      <button class="add" type="button" data-add data-title={p.title}>
        <Icon name={free ? 'download' : 'cart'} size={16} />
        {free ? 'Get' : 'Add to cart'}
      </button>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--s1);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.3s var(--ease), box-shadow 0.3s;
  }
  .card:hover {
    border-color: #38465f;
    transform: translateY(-3px);
    box-shadow: 0 16px 36px -18px rgb(0 0 0 / 0.9);
  }
  .card.enter {
    animation: enter 0.45s var(--ease) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }
  }
  .thumb {
    position: relative;
    aspect-ratio: 4 / 3.2;
    background: radial-gradient(ellipse 80% 75% at 50% 40%, #2a3447, #121720 78%);
    overflow: hidden;
  }
  .thumb :global(.art) {
    padding: 5%;
    transition: transform 0.5s var(--ease);
  }
  .card:hover .thumb :global(.art) {
    transform: scale(1.05);
  }
  .badges {
    position: absolute;
    inset: 10px auto auto 10px;
    display: flex;
    gap: 6px;
  }
  .b {
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 800;
  }
  .new {
    background: var(--ok);
    color: #04210f;
  }
  .sale {
    background: var(--sale);
    color: #2b0610;
  }
  .free {
    background: #e6eaf0;
    color: #0c0f14;
  }
  .fav {
    position: absolute;
    inset: 8px 8px auto auto;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: rgb(12 15 20 / 0.7);
    cursor: pointer;
    transition: background 0.15s, transform 0.2s var(--ease);
  }
  .fav:hover {
    background: var(--s3);
    transform: scale(1.1);
  }
  .fav[aria-pressed='true'] {
    color: var(--sale);
  }
  .fav[aria-pressed='true'] :global(path) {
    fill: currentColor;
  }
  .dots {
    position: absolute;
    inset: auto 0 10px;
    display: flex;
    justify-content: center;
    gap: 5px;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .card:hover .dots {
    opacity: 1;
  }
  .dots i {
    width: 18px;
    height: 3px;
    border-radius: 2px;
    background: #44516a;
    transition: background 0.2s, width 0.2s;
  }
  .thumb[data-view='render'] .dots i:nth-child(1),
  .thumb[data-view='clay'] .dots i:nth-child(2),
  .thumb[data-view='wire'] .dots i:nth-child(3) {
    width: 26px;
    background: var(--acc-h);
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 3px;
    padding: 12px 14px 14px;
  }
  .cat {
    margin: 0;
    color: var(--mut);
    font-size: 0.78rem;
    font-weight: 600;
  }
  h3 {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 750;
    line-height: 1.3;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  h3 a:hover {
    color: var(--acc-h);
  }
  .desc {
    display: none;
    margin: 2px 0;
    color: #b2bccb;
  }
  .rate {
    display: flex;
    align-items: center;
    gap: 5px;
    margin: 2px 0 0;
    color: var(--mut);
    font-size: 0.82rem;
  }
  .rate :global(svg:first-child) {
    color: #ffc247;
    fill: #ffc247;
  }
  .rate b {
    color: var(--text);
  }
  .dl {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }
  .buy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: auto;
    padding-top: 10px;
  }
  .price {
    margin: 0;
  }
  .price b {
    font-size: 1.2rem;
    font-weight: 800;
  }
  .price s {
    margin-left: 6px;
    color: var(--mut);
    font-size: 0.85rem;
  }
  .add {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid #33405a;
    border-radius: 8px;
    background: none;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, transform 0.15s;
  }
  .add:hover {
    border-color: var(--acc-btn);
    background: var(--acc-btn);
    color: #fff;
  }
  .add:active {
    transform: scale(0.95);
  }

  /* List view, toggled from the toolbar */
  :global(.m6 .list) .card {
    flex-direction: row;
  }
  :global(.m6 .list) .thumb {
    flex: none;
    width: clamp(130px, 28%, 260px);
    aspect-ratio: auto;
  }
  :global(.m6 .list) .desc {
    display: block;
  }
  :global(.m6 .list) .body {
    padding: 14px 18px;
  }
  :global(.m6 .list) .buy {
    justify-content: flex-start;
    gap: 18px;
  }
  @media (max-width: 599px) {
    :global(.m6 .list) .desc {
      display: none;
    }
  }
</style>
