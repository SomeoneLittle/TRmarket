---
import '@fontsource-variable/manrope';
import { href } from '../../data/products';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0f14" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
  </head>
  <body class="m6">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="m6-cyl" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#000" stop-opacity="0.55" />
          <stop offset="0.2" stop-color="#000" stop-opacity="0.1" />
          <stop offset="0.34" stop-color="#fff" stop-opacity="0.3" />
          <stop offset="0.45" stop-color="#fff" stop-opacity="0" />
          <stop offset="0.72" stop-color="#000" stop-opacity="0.14" />
          <stop offset="1" stop-color="#000" stop-opacity="0.62" />
        </linearGradient>
      </defs>
    </svg>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <div class="toast" role="status" aria-live="polite"></div>
    <a class="back" href={href()} lang="ru">← к выбору макетов</a>

    <script>
      // Cart counter + toast, wishlist toggle.
      const counters = document.querySelectorAll<HTMLElement>('[data-cart-count]');
      const toast = document.querySelector<HTMLElement>('.toast')!;
      let count = 2;
      let timer: number | undefined;
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const add = t.closest<HTMLElement>('[data-add]');
        if (add) {
          e.preventDefault();
          count++;
          counters.forEach((c) => {
            c.textContent = String(count);
            c.classList.remove('bump');
            void c.offsetWidth;
            c.classList.add('bump');
          });
          toast.textContent = `${add.dataset.title} added to cart`;
          toast.classList.add('show');
          clearTimeout(timer);
          timer = window.setTimeout(() => toast.classList.remove('show'), 2400);
          return;
        }
        const fav = t.closest<HTMLElement>('[data-fav]');
        if (fav) {
          e.preventDefault();
          fav.setAttribute('aria-pressed', String(fav.getAttribute('aria-pressed') !== 'true'));
        }
      });
    </script>
  </body>
</html>

<style is:global>
  .m6 {
    --bg: #0c0f14;
    --s1: #121720;
    --s2: #1a212c;
    --s3: #232c3a;
    --line: #232b38;
    --text: #e6eaf0;
    --mut: #9aa5b5;
    --acc: #4f8cff;
    --acc-btn: #2f6df0;
    --acc-h: #6fa0ff;
    --ok: #3fd18a;
    --sale: #ff6b78;
    --font: 'Manrope Variable', system-ui, sans-serif;
    --wrap: min(1440px, 100% - clamp(24px, 4vw, 56px));
    --ease: cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .m6 {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 450 0.95rem/1.5 var(--font);
    -webkit-font-smoothing: antialiased;
  }
  .m6 *,
  .m6 *::before,
  .m6 *::after {
    box-sizing: border-box;
  }
  .m6 a {
    color: inherit;
  }
  .m6 button,
  .m6 input,
  .m6 select {
    font: inherit;
    color: inherit;
  }
  .m6 :focus-visible {
    outline: 2px solid var(--acc-h);
    outline-offset: 2px;
    border-radius: 6px;
  }
  .m6 .wrap {
    width: var(--wrap);
    margin-inline: auto;
  }
  .m6 .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .m6 .skip {
    position: fixed;
    inset: 8px auto auto 8px;
    z-index: 300;
    padding: 0.6rem 1rem;
    border-radius: 8px;
    background: var(--acc-btn);
    color: #fff;
    font-weight: 700;
    transform: translateY(-200%);
  }
  .m6 .skip:focus {
    transform: none;
  }
  .m6 .back {
    position: fixed;
    inset: auto auto 14px 14px;
    z-index: 90;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgb(26 33 44 / 0.96);
    font: 500 0.78rem system-ui, sans-serif;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .m6 .back:hover {
    border-color: var(--acc);
  }
  .m6 .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1.2rem;
    border: 0;
    border-radius: 8px;
    background: var(--acc-btn);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s, transform 0.15s, box-shadow 0.2s;
  }
  .m6 .btn:hover {
    background: #4580f5;
    box-shadow: 0 8px 22px -8px rgb(47 109 240 / 0.7);
  }
  .m6 .btn:active {
    transform: scale(0.97);
  }
  .m6 .btn.ghost {
    background: transparent;
    box-shadow: inset 0 0 0 1px #33405a;
  }
  .m6 .btn.ghost:hover {
    background: var(--s2);
    box-shadow: inset 0 0 0 1px var(--acc);
  }
  .m6 .toast {
    position: fixed;
    inset: auto 16px 16px auto;
    z-index: 160;
    max-width: calc(100vw - 32px);
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--ok);
    border-radius: 8px;
    background: var(--s2);
    box-shadow: 0 12px 32px -8px rgb(0 0 0 / 0.7);
    transform: translateY(24px);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.3s var(--ease), opacity 0.25s;
  }
  .m6 .toast.show {
    transform: none;
    opacity: 1;
  }
  .m6 .bump {
    animation: bump 0.35s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  @keyframes bump {
    40% {
      transform: scale(1.5);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .m6 * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
