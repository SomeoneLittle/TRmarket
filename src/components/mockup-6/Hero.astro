---
import { formatAdded, formatPrice, freshProducts, products } from '../../data/products';
import Art from './Art.astro';
import Icon from './Icon.astro';

const byId = (id: string) => products.find((p) => p.id === id)!;
const tiles = [byId('aeon-vase-collection'), byId('claystroke-brush-set'), byId('sentinel-helmet-kit')];
const stats = [
  { n: 212, label: 'Models & tools' },
  { n: 48300, label: 'Downloads' },
  { n: 4.8, label: 'Average rating', dec: true },
];
const tags = ['Vases', 'Helmets', 'Brushes', 'Remesh', 'Low-poly', 'Free'];
const ticker = [...freshProducts, ...freshProducts];
---

<section class="hero wrap" aria-labelledby="m6-h1">
  <div class="copy">
    <p class="kick"><Icon name="gift" size={16} /> 3 free downloads this week</p>
    <h1 id="m6-h1">3D models and tools,<br />made by one maker.</h1>
    <p class="lead">Printable sets, game-ready assets, sculpting brushes and Blender add-ons. Tested, licensed for commercial use and updated for life.</p>
    <div class="cta">
      <a class="btn" href="#browse">Browse the catalog <Icon name="arrow" size={18} /></a>
      <a class="btn ghost" href="#browse" data-goto="free">Free downloads</a>
    </div>
    <p class="tags"><span>Popular:</span>{tags.map((t) => <a href="#">{t}</a>)}</p>
    <dl class="stats">
      {
        stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd data-count={s.n} data-dec={s.dec ? 1 : 0}>{s.dec ? s.n.toFixed(1) : s.n.toLocaleString('en-US')}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="mosaic">
    {
      tiles.map((p, i) => (
        <article class={`tile t${i}`}>
          <a class="art" href="#" aria-label={`${p.title}, ${formatPrice(p.price)}`}><Art product={p} /></a>
          <div class="over">
            <div>
              <b>{p.title}</b>
              <small>{p.kind} · {formatPrice(p.price)}</small>
            </div>
            <button class="btn" type="button" data-add data-title={p.title}><Icon name="cart" size={17} /><span>Add</span></button>
          </div>
        </article>
      ))
    }
  </div>
</section>

<div class="ticker" role="region" aria-label="Just added">
  <p class="lab"><i aria-hidden="true"></i>Just added</p>
  <div class="mask">
    <ul class="run">
      {
        ticker.map((p, i) => (
          <li aria-hidden={i >= freshProducts.length ? 'true' : undefined}>
            <a href="#" tabindex={i >= freshProducts.length ? -1 : undefined}><time>{formatAdded(p.addedHours)}</time> {p.title} <b>{formatPrice(p.price)}</b></a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .hero {
    display: grid;
    gap: 28px;
    padding-top: 28px;
  }
  .kick {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    padding: 5px 12px;
    border-radius: 99px;
    background: rgb(63 209 138 / 0.12);
    color: var(--ok);
    font-weight: 700;
    font-size: 0.85rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 4.8vw, 3.9rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.04em;
  }
  .lead {
    max-width: 32rem;
    margin: 16px 0 22px;
    color: #bcc6d4;
    font-size: 1.08rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 20px 0 0;
    color: var(--mut);
  }
  .tags a {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 99px;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .tags a:hover {
    border-color: var(--acc);
    background: var(--s2);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 8px 32px;
    margin: 28px 0 0;
  }
  .stats dt {
    order: 2;
    color: var(--mut);
    font-size: 0.85rem;
  }
  .stats div {
    display: flex;
    flex-direction: column;
  }
  .stats dd {
    margin: 0;
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .mosaic {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: 'a a' 'b c';
    gap: 12px;
  }
  .t0 {
    grid-area: a;
  }
  .t1 {
    grid-area: b;
  }
  .t2 {
    grid-area: c;
  }
  .tile {
    position: relative;
    min-height: 180px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: radial-gradient(ellipse 80% 80% at 50% 40%, #2a3447, #121720 78%);
    overflow: hidden;
    transition: border-color 0.2s;
  }
  .tile:hover,
  .tile:focus-within {
    border-color: #3c4d6c;
  }
  .art {
    position: absolute;
    inset: 0 0 52px;
    display: grid;
    place-items: center;
  }
  .art :global(.art) {
    width: auto;
    height: 100%;
    max-height: 340px;
    padding: 4%;
    transition: transform 0.6s var(--ease);
  }
  .tile:hover .art :global(.art) {
    transform: scale(1.06) translateY(-4px);
  }
  .over {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 12px 10px 16px;
    background: linear-gradient(transparent, rgb(8 10 14 / 0.9) 40%);
  }
  .over div {
    display: grid;
    min-width: 0;
  }
  .over small {
    color: var(--mut);
  }
  .over .btn {
    min-height: 40px;
    padding: 0 14px;
    transform: translateY(8px);
    opacity: 0;
    transition: transform 0.3s var(--ease), opacity 0.2s, background 0.15s;
  }
  .tile:hover .btn,
  .tile:focus-within .btn {
    transform: none;
    opacity: 1;
  }
  @media (hover: none) {
    .over .btn {
      transform: none;
      opacity: 1;
    }
  }
  .ticker {
    display: flex;
    align-items: center;
    margin-top: 32px;
    border-block: 1px solid var(--line);
    background: var(--s1);
  }
  .lab {
    display: flex;
    flex: none;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 12px 16px;
    border-right: 1px solid var(--line);
    font-weight: 700;
    font-size: 0.85rem;
    background: var(--s2);
    position: relative;
    z-index: 1;
  }
  .lab i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
    animation: ping 1.8s ease-out infinite;
  }
  @keyframes ping {
    0% {
      box-shadow: 0 0 0 0 rgb(63 209 138 / 0.6);
    }
    100% {
      box-shadow: 0 0 0 9px rgb(63 209 138 / 0);
    }
  }
  .mask {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .run {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: run 40s linear infinite;
  }
  .run li {
    padding-right: 36px;
  }
  .run li:first-child {
    padding-left: 18px;
  }
  .ticker:hover .run {
    animation-play-state: paused;
  }
  @keyframes run {
    to {
      transform: translateX(-50%);
    }
  }
  .run a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    white-space: nowrap;
    text-decoration: none;
  }
  .run a:hover {
    color: var(--acc-h);
  }
  .run time {
    color: var(--mut);
    font-size: 0.82rem;
  }
  @media (min-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 48px;
      align-items: center;
    }
    .mosaic {
      grid-template-columns: 1.3fr 1fr;
      grid-template-areas: 'a b' 'a c';
      grid-template-rows: 1fr 1fr;
      min-height: 520px;
    }
  }
</style>

<script>
  // Count-up for the hero stats when they scroll into view.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nodes = document.querySelectorAll<HTMLElement>('[data-count]');
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (!en.isIntersecting) continue;
        io.unobserve(en.target);
        const el = en.target as HTMLElement;
        const end = Number(el.dataset.count);
        const dec = el.dataset.dec === '1';
        const t0 = performance.now();
        const tick = (t: number) => {
          const k = Math.min(1, (t - t0) / 1200);
          const v = end * (1 - Math.pow(1 - k, 3));
          el.textContent = dec ? v.toFixed(1) : Math.round(v).toLocaleString('en-US');
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    });
    nodes.forEach((n) => io.observe(n));
  }
</script>
