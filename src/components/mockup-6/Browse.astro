---
import { categories, products } from '../../data/products';
import Card from './Card.astro';
import Icon from './Icon.astro';

const tabs = [
  { id: 'trending', label: 'Trending', icon: 'trend' },
  { id: 'new', label: 'New', icon: 'clock' },
  { id: 'rated', label: 'Top rated', icon: 'award' },
  { id: 'free', label: 'Free', icon: 'gift' },
] as const;

const subs = {
  print: ['Home & decor', 'Tabletop', 'Organizers', 'Planters'],
  game: ['Characters & armor', 'Environment', 'Props', 'Nature'],
  tool: ['Brushes', 'Add-ons', 'Scripts', 'Presets'],
};
const prices = [
  { id: 'any', label: 'Any price' },
  { id: 'free', label: 'Free' },
  { id: 'u15', label: 'Under $15' },
  { id: 'm25', label: '$15 – $25' },
  { id: 'o25', label: 'Over $25' },
];
const formats = [
  { id: 'stl', label: 'STL' },
  { id: '3mf', label: '3MF' },
  { id: 'fbx', label: 'FBX' },
  { id: 'glb', label: 'GLB' },
  { id: 'blend', label: 'BLEND' },
  { id: 'blender', label: 'Blender add-on' },
];
const count = (fn: (p: (typeof products)[number]) => boolean) => products.filter(fn).length;
---

<div class="wrap shell" id="browse">
  <aside class="side" aria-label="Filters">
    <button class="ftoggle" type="button" aria-expanded="false" aria-controls="m6-filters"><Icon name="filter" size={18} /> Filters <span data-active-n hidden></span></button>
    <div class="panel" id="m6-filters">
      <section>
        <h2>Categories</h2>
        <ul class="cats">
          <li><button type="button" data-cat="all" aria-pressed="true">All products <small>{products.length}</small></button></li>
          {
            categories.map((c) => (
              <li>
                <details>
                  <summary><button type="button" data-cat={c.id} aria-pressed="false">{c.name} <small>{c.count}</small></button><Icon name="chevron" size={16} /></summary>
                  <ul class="sub">
                    {subs[c.id].map((s) => <li><a href="#">{s}</a></li>)}
                  </ul>
                </details>
              </li>
            ))
          }
        </ul>
      </section>
      <section>
        <h2>Price</h2>
        <div class="opts" role="radiogroup" aria-label="Price">
          {
            prices.map((p, i) => (
              <label>
                <input type="radio" name="m6-price" value={p.id} checked={i === 0} />
                <span>{p.label}</span>
              </label>
            ))
          }
        </div>
      </section>
      <section>
        <h2>Format</h2>
        <div class="opts">
          {
            formats.map((f) => (
              <label>
                <input type="checkbox" name="m6-format" value={f.id} />
                <span>{f.label}</span>
                <small>{count((p) => p.formats.some((x) => (f.id === 'blender' ? x.toLowerCase().startsWith('blender') : x.toLowerCase() === f.id)))}</small>
              </label>
            ))
          }
        </div>
      </section>
      <button class="reset" type="button" data-reset>Reset filters</button>
    </div>
  </aside>

  <section class="main" aria-labelledby="m6-title">
    <div class="bar">
      <h2 id="m6-title" class="sr">Products</h2>
      <div class="tabs" role="group" aria-label="Show">
        <i class="ind" aria-hidden="true"></i>
        {tabs.map((t, i) => <button type="button" data-tab={t.id} aria-pressed={i === 0 ? 'true' : 'false'}><Icon name={t.icon} size={17} /> {t.label}</button>)}
      </div>
      <p class="count" aria-live="polite">Showing <b data-shown>{products.length}</b> of {products.length}</p>
      <div class="view" role="group" aria-label="Layout">
        <button type="button" data-layout="grid" aria-pressed="true" aria-label="Grid view"><Icon name="grid" size={18} /></button>
        <button type="button" data-layout="list" aria-pressed="false" aria-label="List view"><Icon name="list" size={18} /></button>
      </div>
    </div>
    <p class="empty" data-empty hidden>No products match these filters. <button type="button" data-reset>Reset filters</button></p>
    <ul class="grid" data-grid>
      {products.map((p) => <li data-cell><Card product={p} /></li>)}
    </ul>
  </section>
</div>

<style>
  .shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    margin-top: 36px;
  }
  .ftoggle {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    min-height: 46px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--s1);
    font-weight: 700;
    cursor: pointer;
  }
  .ftoggle span {
    margin-left: auto;
    padding: 0 8px;
    border-radius: 99px;
    background: var(--acc-btn);
    color: #fff;
    font-size: 0.8rem;
  }
  .panel {
    display: grid;
    gap: 22px;
    max-height: 0;
    padding: 0 16px;
    border: 0 solid var(--line);
    border-radius: 12px;
    background: var(--s1);
    overflow: hidden;
    transition: max-height 0.4s var(--ease), padding 0.3s, margin 0.3s;
  }
  .panel.open {
    max-height: 900px;
    margin-top: 8px;
    padding: 18px 16px;
    border-width: 1px;
  }
  h2 {
    margin: 0 0 8px;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mut);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cats button {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 40px;
    padding: 0 10px;
    border: 0;
    border-radius: 8px;
    background: none;
    text-align: left;
    font-weight: 650;
    cursor: pointer;
    transition: background 0.15s;
  }
  .cats button:hover {
    background: var(--s2);
  }
  .cats button[aria-pressed='true'] {
    background: rgb(79 140 255 / 0.16);
    color: var(--acc-h);
  }
  small {
    color: var(--mut);
    font-weight: 500;
  }
  summary {
    display: flex;
    align-items: center;
    padding-right: 8px;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary :global(svg) {
    flex: none;
    color: var(--mut);
    transition: transform 0.25s var(--ease);
  }
  details[open] summary :global(svg) {
    transform: rotate(180deg);
  }
  .sub {
    padding: 2px 0 6px 18px;
    border-left: 1px solid var(--line);
    margin-left: 14px;
  }
  .sub a {
    display: block;
    padding: 5px 10px;
    border-radius: 6px;
    color: #b6c0cf;
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }
  .sub a:hover {
    background: var(--s2);
    color: var(--text);
  }
  details[open] .sub {
    animation: drop 0.25s var(--ease);
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .opts {
    display: grid;
    gap: 2px;
  }
  .opts label {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 10px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s;
  }
  .opts label:hover {
    background: var(--s2);
  }
  .opts small {
    margin-left: auto;
  }
  .opts input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--acc-btn);
  }
  .reset,
  .empty button {
    min-height: 44px;
    border: 1px solid #33405a;
    border-radius: 8px;
    background: none;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .reset:hover,
  .empty button:hover {
    border-color: var(--acc);
    background: var(--s2);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-bottom: 16px;
  }
  .tabs {
    position: relative;
    display: flex;
    gap: 2px;
    max-width: 100%;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--s1);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .ind {
    position: absolute;
    inset: 4px auto 4px 0;
    width: var(--w, 0);
    border-radius: 8px;
    background: var(--s3);
    transform: translateX(var(--x, 4px));
    transition: transform 0.35s var(--ease), width 0.35s var(--ease);
  }
  .tabs button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    padding: 0 14px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--mut);
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.15s;
  }
  .tabs button:hover,
  .tabs button[aria-pressed='true'] {
    color: var(--text);
  }
  .count {
    margin: 0 auto 0 0;
    color: var(--mut);
  }
  .count b {
    color: var(--text);
  }
  .view {
    display: flex;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--s1);
  }
  .view button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 38px;
    border: 0;
    border-radius: 7px;
    background: none;
    color: var(--mut);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .view button[aria-pressed='true'] {
    background: var(--s3);
    color: var(--text);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .grid.list {
    grid-template-columns: minmax(0, 1fr);
  }
  .grid > li {
    display: flex;
  }
  .grid > li > :global(.card) {
    flex: 1;
  }
  .empty {
    margin: 0 0 16px;
    padding: 28px;
    border: 1px dashed #33405a;
    border-radius: 12px;
    color: var(--mut);
    text-align: center;
  }
  .empty button {
    margin-left: 8px;
    padding: 0 14px;
  }
  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
    .grid.list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (min-width: 960px) {
    .shell {
      grid-template-columns: 270px minmax(0, 1fr);
      gap: 32px;
      align-items: start;
    }
    .side {
      position: sticky;
      top: 82px;
    }
    .ftoggle {
      display: none;
    }
    .panel {
      max-height: none;
      padding: 18px 16px;
      border-width: 1px;
      overflow: visible;
    }
  }
  @media (min-width: 1280px) {
    .grid:not(.list) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

<script>
  type Tab = 'trending' | 'new' | 'rated' | 'free';
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const cells = [...grid.querySelectorAll<HTMLElement>('[data-cell]')];
  const shownEl = document.querySelector<HTMLElement>('[data-shown]')!;
  const emptyEl = document.querySelector<HTMLElement>('[data-empty]')!;
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const ind = document.querySelector<HTMLElement>('.ind')!;
  const cats = [...document.querySelectorAll<HTMLButtonElement>('[data-cat]')];
  const state = { tab: 'trending' as Tab, cat: 'all', price: 'any', formats: new Set<string>() };

  const num = (el: HTMLElement, k: string) => Number(el.querySelector<HTMLElement>('.card')!.dataset[k]);
  const priceOk = (p: number) =>
    state.price === 'any' || (state.price === 'free' && p === 0) || (state.price === 'u15' && p < 15) ||
    (state.price === 'm25' && p >= 15 && p <= 25) || (state.price === 'o25' && p > 25);
  const formatOk = (list: string[]) =>
    state.formats.size === 0 ||
    [...state.formats].some((f) => list.some((x) => (f === 'blender' ? x.startsWith('blender') : x === f)));

  const moveIndicator = () => {
    const active = tabs.find((t) => t.getAttribute('aria-pressed') === 'true')!;
    ind.style.setProperty('--x', `${active.offsetLeft}px`);
    ind.style.setProperty('--w', `${active.offsetWidth}px`);
  };

  const apply = () => {
    const rows = cells.map((cell) => {
      const card = cell.querySelector<HTMLElement>('.card')!;
      const ok =
        (state.cat === 'all' || card.dataset.cat === state.cat) &&
        priceOk(num(cell, 'price')) &&
        formatOk(card.dataset.formats!.split('|')) &&
        (state.tab !== 'free' || num(cell, 'price') === 0);
      return { cell, card, ok };
    });
    const key = (c: HTMLElement) =>
      state.tab === 'new' ? num(c, 'added') : state.tab === 'rated' ? -num(c, 'rating') * 1e6 - num(c, 'dl') : -num(c, 'dl');
    rows.sort((a, b) => key(a.cell) - key(b.cell));
    let n = 0;
    rows.forEach((r, i) => {
      r.cell.style.order = String(i);
      r.cell.hidden = !r.ok;
      if (r.ok) {
        r.card.style.setProperty('--d', `${n++ * 40}ms`);
        r.card.classList.remove('enter');
        void r.card.offsetWidth;
        r.card.classList.add('enter');
      }
    });
    shownEl.textContent = String(n);
    emptyEl.hidden = n > 0;
    const active = (state.cat !== 'all' ? 1 : 0) + (state.price !== 'any' ? 1 : 0) + state.formats.size;
    const badge = document.querySelector<HTMLElement>('[data-active-n]')!;
    badge.hidden = active === 0;
    badge.textContent = String(active);
  };

  const setTab = (t: Tab) => {
    state.tab = t;
    tabs.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tab === t)));
    moveIndicator();
    apply();
  };
  tabs.forEach((b) => b.addEventListener('click', () => setTab(b.dataset.tab as Tab)));

  cats.forEach((b) =>
    b.addEventListener('click', (e) => {
      e.preventDefault(); // keeps <details> from toggling when the label is used as a filter
      state.cat = b.dataset.cat!;
      cats.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    }),
  );
  document.querySelectorAll<HTMLInputElement>('input[name="m6-price"]').forEach((r) =>
    r.addEventListener('change', () => {
      state.price = r.value;
      apply();
    }),
  );
  document.querySelectorAll<HTMLInputElement>('input[name="m6-format"]').forEach((c) =>
    c.addEventListener('change', () => {
      c.checked ? state.formats.add(c.value) : state.formats.delete(c.value);
      apply();
    }),
  );
  document.querySelectorAll('[data-reset]').forEach((b) =>
    b.addEventListener('click', () => {
      state.cat = 'all';
      state.price = 'any';
      state.formats.clear();
      cats.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.cat === 'all')));
      document.querySelectorAll<HTMLInputElement>('input[name="m6-price"]').forEach((r) => (r.checked = r.value === 'any'));
      document.querySelectorAll<HTMLInputElement>('input[name="m6-format"]').forEach((c) => (c.checked = false));
      apply();
    }),
  );

  // Grid / list layout
  const layoutBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-layout]')];
  layoutBtns.forEach((b) =>
    b.addEventListener('click', () => {
      grid.classList.toggle('list', b.dataset.layout === 'list');
      layoutBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    }),
  );

  // Mobile filter panel
  const toggle = document.querySelector<HTMLButtonElement>('.ftoggle')!;
  const panel = document.getElementById('m6-filters')!;
  toggle.addEventListener('click', () => {
    const open = panel.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });

  // Hover preview: pointer position over the thumbnail switches the view.
  grid.addEventListener('pointermove', (e) => {
    const thumb = (e.target as HTMLElement).closest<HTMLElement>('.thumb[data-hover]');
    if (!thumb || (e as PointerEvent).pointerType === 'touch') return;
    const r = thumb.getBoundingClientRect();
    const k = Math.min(2, Math.floor(((e.clientX - r.left) / r.width) * 3));
    thumb.dataset.view = ['render', 'clay', 'wire'][k];
  });
  grid.addEventListener('pointerout', (e) => {
    const thumb = (e.target as HTMLElement).closest<HTMLElement>('.thumb[data-hover]');
    if (thumb && !thumb.contains((e as PointerEvent).relatedTarget as Node)) thumb.dataset.view = 'render';
  });

  // "Free downloads" button in the hero jumps to the Free tab.
  document.querySelectorAll<HTMLElement>('[data-goto="free"]').forEach((a) =>
    a.addEventListener('click', () => setTab('free')),
  );

  moveIndicator();
  window.addEventListener('resize', moveIndicator);
  document.fonts?.ready.then(moveIndicator);
</script>
