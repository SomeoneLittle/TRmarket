---
import { products, formatPrice } from '../../data/products';
import Icon from './Icon.astro';
import Art from './Art.astro';

const nav = [
  { label: 'Home', current: true },
  { label: 'Marketplace' },
  { label: 'Blog' },
];
const queries = ['spiral vase', 'sci-fi helmet', 'sculpting brushes', 'blender remesh', 'low-poly trees'];
const top = [products[0], products[4]];
---

<header class="hd">
  <div class="wrap in">
    <a class="logo" href="#" aria-label="TRmarket, home">
      <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#2f6df0" /><path d="M16 7l8 4.5v9L16 25l-8-4.5v-9zM8 11.5l8 4.5 8-4.5M16 16v9" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round" /></svg>
      TRmarket
    </a>

    <nav aria-label="Main">
      <ul>
        {nav.map((n) => <li><a href="#" aria-current={n.current ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>

    <form class="search" role="search" action="#" onsubmit="return false">
      <div class="field">
        <Icon name="search" size={19} />
        <label class="sr" for="m6-q">Search</label>
        <input id="m6-q" type="search" placeholder="Search 3D models, tools, add-ons…" autocomplete="off" />
        <kbd aria-hidden="true">/</kbd>
      </div>
      <div class="sugg">
        <p class="h">Popular searches</p>
        <ul class="q">
          {queries.map((q) => <li><a href="#"><Icon name="trend" size={15} /> {q}</a></li>)}
        </ul>
        <p class="h">Top results</p>
        <ul class="top">
          {
            top.map((p) => (
              <li>
                <a href="#">
                  <span class="th"><Art product={p} /></span>
                  <span><b>{p.title}</b><small>{formatPrice(p.price)}</small></span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </form>

    <div class="acts">
      <a class="ib" href="#" aria-label="Favorites"><Icon name="heart" size={22} /></a>
      <a class="ib" href="#" aria-label="Account"><Icon name="user" size={22} /></a>
      <a class="ib" href="#"><span class="sr">Cart</span><Icon name="cart" size={22} /><b data-cart-count>2</b></a>
    </div>
  </div>
</header>

<style>
  .hd {
    position: relative;
    z-index: 100;
    border-bottom: 1px solid var(--line);
    background: rgb(12 15 20 / 0.92);
    backdrop-filter: blur(12px);
  }
  .in {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'logo acts' 'nav nav' 'search search';
    gap: 6px 12px;
    align-items: center;
    padding-block: 10px;
  }
  .logo {
    grid-area: logo;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: max-content;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  nav {
    grid-area: nav;
  }
  ul {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 8px;
    color: var(--mut);
    font-weight: 650;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  nav a:hover {
    background: var(--s2);
    color: var(--text);
  }
  nav a[aria-current] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--acc);
    border-radius: 8px 8px 0 0;
  }
  .search {
    grid-area: search;
    position: relative;
  }
  .field {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    border: 1px solid #2d384a;
    border-radius: 10px;
    background: var(--s1);
    color: var(--mut);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .search:focus-within .field {
    border-color: var(--acc);
    box-shadow: 0 0 0 3px rgb(79 140 255 / 0.2);
  }
  input {
    flex: 1;
    min-width: 0;
    min-height: 46px;
    border: 0;
    background: none;
    color: var(--text);
  }
  input:focus {
    outline: none;
  }
  input::placeholder {
    color: #8993a3;
  }
  kbd {
    padding: 1px 8px;
    border: 1px solid #33405a;
    border-radius: 5px;
    font: 600 0.8rem var(--font);
  }
  .sugg {
    position: absolute;
    inset: calc(100% + 8px) 0 auto;
    z-index: 20;
    padding: 14px 16px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--s1);
    box-shadow: 0 24px 48px -12px rgb(0 0 0 / 0.8);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.2s, transform 0.25s var(--ease), visibility 0s 0.25s;
  }
  .search:focus-within .sugg {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }
  .h {
    margin: 0 0 6px;
    color: var(--mut);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .q {
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
  }
  .q a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 99px;
    background: var(--s2);
    text-decoration: none;
    transition: background 0.15s;
  }
  .q a:hover {
    background: var(--s3);
  }
  .top {
    flex-direction: column;
  }
  .top a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px;
    border-radius: 8px;
    text-decoration: none;
  }
  .top a:hover {
    background: var(--s2);
  }
  .th {
    width: 46px;
    height: 46px;
    border-radius: 8px;
    background: var(--s2);
    overflow: hidden;
  }
  .top span:last-child {
    display: grid;
  }
  .top small {
    color: var(--mut);
  }
  .acts {
    grid-area: acts;
    display: flex;
    gap: 2px;
    justify-self: end;
  }
  .ib {
    position: relative;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 10px;
    transition: background 0.15s;
  }
  .ib:hover {
    background: var(--s2);
  }
  .ib b {
    position: absolute;
    inset: 3px 1px auto auto;
    display: grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 99px;
    background: var(--acc-btn);
    color: #fff;
    font-size: 0.7rem;
  }
  @media (min-width: 960px) {
    .hd {
      position: sticky;
      top: 0;
    }
    .in {
      grid-template-columns: auto auto minmax(300px, 1fr) auto;
      grid-template-areas: 'logo nav search acts';
      gap: 24px;
    }
  }
</style>
