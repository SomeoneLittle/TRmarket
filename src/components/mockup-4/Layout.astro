---
import '@fontsource-variable/inter';
import { href } from '../../data/products';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e0f11" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="m4">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="m4-cyl" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#000" stop-opacity="0.55" />
          <stop offset="0.22" stop-color="#000" stop-opacity="0.1" />
          <stop offset="0.36" stop-color="#fff" stop-opacity="0.28" />
          <stop offset="0.46" stop-color="#fff" stop-opacity="0" />
          <stop offset="0.7" stop-color="#000" stop-opacity="0.12" />
          <stop offset="1" stop-color="#000" stop-opacity="0.6" />
        </linearGradient>
      </defs>
    </svg>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <div class="toast" role="status" aria-live="polite"></div>
    <a class="back" href={href()} lang="ru">← к выбору макетов</a>

    <script>
      // Add to cart: bump the counter and show a toast. Wishlist: toggle the heart. Reveal on scroll.
      const counters = document.querySelectorAll<HTMLElement>('[data-cart-count]');
      const toast = document.querySelector<HTMLElement>('.toast')!;
      let count = 2;
      let timer: number | undefined;

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const add = target.closest<HTMLElement>('[data-add]');
        if (add) {
          e.preventDefault();
          count++;
          counters.forEach((c) => {
            c.textContent = String(count);
            c.classList.remove('bump');
            void c.offsetWidth;
            c.classList.add('bump');
          });
          toast.textContent = `Added to cart: ${add.dataset.title}`;
          toast.classList.add('show');
          clearTimeout(timer);
          timer = window.setTimeout(() => toast.classList.remove('show'), 2600);
          return;
        }
        const fav = target.closest<HTMLElement>('[data-fav]');
        if (fav) {
          e.preventDefault();
          const on = fav.getAttribute('aria-pressed') !== 'true';
          fav.setAttribute('aria-pressed', String(on));
        }
      });

      const items = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                en.target.classList.add('in');
                io.unobserve(en.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>

<style is:global>
  .m4 {
    --bg: #0e0f11;
    --s1: #16181b;
    --s2: #1e2125;
    --s3: #272b30;
    --line: #2c3036;
    --text: #eceef1;
    --mut: #a0a7b1;
    --acc: #ff7a1a;
    --acc-h: #ff8f3d;
    --ok: #35d07f;
    --sale: #ff5a5f;
    --font: 'Inter Variable', system-ui, sans-serif;
    --wrap: min(1400px, 100% - clamp(24px, 5vw, 64px));
  }
  .m4 {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 400 0.95rem/1.5 var(--font);
    -webkit-font-smoothing: antialiased;
  }
  .m4 *,
  .m4 *::before,
  .m4 *::after {
    box-sizing: border-box;
  }
  .m4 a {
    color: inherit;
  }
  .m4 button {
    font: inherit;
    color: inherit;
  }
  .m4 :focus-visible {
    outline: 2px solid var(--acc-h);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .m4 .wrap {
    width: var(--wrap);
    margin-inline: auto;
  }
  .m4 .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .m4 .skip {
    position: fixed;
    inset: 8px auto auto 8px;
    z-index: 200;
    padding: 0.6rem 1rem;
    border-radius: 6px;
    background: var(--acc);
    color: #111;
    font-weight: 600;
    transform: translateY(-200%);
  }
  .m4 .skip:focus {
    transform: none;
  }
  .m4 .back {
    position: fixed;
    inset: auto auto 14px 14px;
    z-index: 150;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgb(30 33 37 / 0.95);
    font: 500 0.78rem system-ui, sans-serif;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .m4 .back:hover {
    border-color: var(--acc);
    background: var(--s3);
  }
  .m4 .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1.25rem;
    border: 0;
    border-radius: 8px;
    background: var(--acc);
    color: #111;
    font-weight: 650;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s, transform 0.15s, box-shadow 0.2s;
  }
  .m4 .btn:hover {
    background: var(--acc-h);
    box-shadow: 0 6px 18px -6px rgb(255 122 26 / 0.6);
  }
  .m4 .btn:active {
    transform: scale(0.97);
  }
  .m4 .btn.ghost {
    background: transparent;
    color: var(--text);
    box-shadow: inset 0 0 0 1px #3a3f47;
  }
  .m4 .btn.ghost:hover {
    background: var(--s3);
    box-shadow: inset 0 0 0 1px var(--acc);
  }
  .m4 .sec {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .m4 .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }
  .m4 h2.t {
    margin: 0;
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-weight: 650;
    letter-spacing: -0.015em;
  }
  .m4 .more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 32px;
    color: var(--acc-h);
    font-weight: 600;
    text-decoration: none;
  }
  .m4 .more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .m4 .toast {
    position: fixed;
    inset: auto 16px 16px auto;
    z-index: 160;
    max-width: calc(100vw - 32px);
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--ok);
    border-radius: 8px;
    background: var(--s2);
    box-shadow: 0 12px 32px -8px rgb(0 0 0 / 0.7);
    transform: translateY(24px);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1), opacity 0.25s;
  }
  .m4 .toast.show {
    transform: none;
    opacity: 1;
  }
  .m4 .bump {
    animation: bump 0.35s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  @keyframes bump {
    40% {
      transform: scale(1.5);
    }
  }
  .js .m4 [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .js .m4 [data-reveal].in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .js .m4 [data-reveal] {
      opacity: 1;
      transform: none;
    }
    .m4 * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
