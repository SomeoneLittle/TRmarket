---
import { lathe, seeded, shade } from '../../data/lathe';
import type { Product } from '../../data/products';

interface Props {
  product: Product;
  label?: string;
}
const { product: p, label = '' } = Astro.props;

const tones = ['#b9bec6', '#c9774f', '#4f9b8f', '#c9a227'];
const base = tones[p.tone];
const isTool = p.category === 'tool';
const model = isTool ? null : lathe(p.profile);

// Tool previews look like a plugin panel: sliders and a small curve.
const rnd = seeded(p.id);
const sliders = Array.from({ length: 4 }, () => 0.25 + rnd() * 0.65);
const curve = Array.from({ length: 9 }, (_, i) => `${i === 0 ? 'M' : 'L'}${(44 + i * 19).toFixed(1)} ${(168 - rnd() * 22).toFixed(1)}`).join('');
---

<svg
  viewBox="0 0 240 240"
  class="art"
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {
    model ? (
      <>
        <ellipse cx="120" cy={model.base.cy + 6} rx={model.base.rx * 1.25} ry={model.base.ry * 1.5} fill="#000" opacity="0.45" />
        {model.bands.map((b) => <path d={b.d} fill={shade(base, b.light)} />)}
        {model.bands.map((b) => <path d={b.d} fill="url(#m4-cyl)" />)}
        {model.top && <ellipse cx="120" cy={model.top.cy} rx={model.top.rx} ry={model.top.ry} fill={shade(base, 0.95)} />}
        {model.top && <ellipse cx="120" cy={model.top.cy} rx={model.top.rx * 0.96} ry={model.top.ry * 0.96} fill="url(#m4-cyl)" />}
      </>
    ) : (
      <g class="panel">
        <rect x="30" y="46" width="180" height="148" rx="8" fill="#1b1e23" stroke="#3a3f47" />
        <rect x="30" y="46" width="180" height="22" rx="8" fill="#252930" />
        <circle cx="44" cy="57" r="3" fill="#ff5f56" />
        <circle cx="55" cy="57" r="3" fill="#ffbd2e" />
        <circle cx="66" cy="57" r="3" fill="#27c93f" />
        {sliders.map((s, i) => (
          <>
            <rect x="44" y={80 + i * 16} width="34" height="5" rx="2.5" fill="#4a5058" />
            <rect x="88" y={80 + i * 16} width="108" height="5" rx="2.5" fill="#323840" />
            <rect x="88" y={80 + i * 16} width={108 * s} height="5" rx="2.5" fill={base} />
            <circle cx={88 + 108 * s} cy={82.5 + i * 16} r="5" fill="#eceef1" />
          </>
        ))}
        <path d={curve} fill="none" stroke={base} stroke-width="2" stroke-linejoin="round" />
        <path d="M44 176H196" stroke="#3a3f47" />
      </g>
    )
  }
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    height: 100%;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  :global(.zoom:hover) .art,
  :global(.zoom:focus-within) .art {
    transform: scale(1.07);
  }
</style>
