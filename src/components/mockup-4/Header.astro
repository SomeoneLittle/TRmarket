---
import Icon from './Icon.astro';

const nav = [
  { label: 'Home', current: true },
  { label: 'Marketplace' },
  { label: 'Blog' },
  { label: 'Free' },
  { label: 'New' },
];
const mega = [
  { title: '3D models for printing', items: ['Home & decor', 'Tabletop & chess', 'Organizers', 'Planters & vases', 'Mechanical parts'] },
  { title: '3D models for games', items: ['Characters & armor', 'Environment kits', 'Props', 'Trees & nature', 'Sci-fi'] },
  { title: 'Tools', items: ['Sculpting brushes', 'Blender add-ons', 'Scripts', 'Hard-surface presets', 'Texture packs'] },
];
---

<div class="util">
  <div class="wrap u-in">
    <p>Instant download · Commercial licence included · 30-day refunds</p>
    <ul>
      <li><a href="#">Support</a></li>
      <li><a href="#">Licences</a></li>
      <li><a href="#">EN / USD</a></li>
    </ul>
  </div>
</div>

<header class="hd">
  <div class="wrap main">
    <a class="logo" href="#" aria-label="TRmarket, home">
      <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M16 3 27 9.5v13L16 29 5 22.5v-13z" fill="#ff7a1a"></path>
        <path d="M5 9.5 16 16l11-6.5M16 16v13" fill="none" stroke="#0e0f11" stroke-width="2"></path>
      </svg>
      TR<span>market</span>
    </a>

    <form class="search" role="search" action="#" onsubmit="return false">
      <label class="sr" for="m4-cat">Category</label>
      <select id="m4-cat">
        <option>All categories</option>
        <option>3D models for printing</option>
        <option>3D models for games</option>
        <option>Tools</option>
      </select>
      <label class="sr" for="m4-q">Search</label>
      <input id="m4-q" type="search" placeholder="Search 3D models, brushes, add-ons…" autocomplete="off" />
      <button type="submit" aria-label="Search"><Icon name="search" size={20} /></button>
    </form>

    <div class="acts">
      <a href="#"><Icon name="heart" size={22} /><span>Favorites</span></a>
      <a href="#"><Icon name="user" size={22} /><span>Account</span></a>
      <a href="#" class="cart">
        <Icon name="cart" size={22} />
        <span>Cart</span>
        <b data-cart-count>2</b>
      </a>
    </div>
  </div>

  <nav class="bar" aria-label="Main">
    <div class="wrap bar-in">
      <div class="catwrap">
        <button class="catbtn" type="button" aria-haspopup="true"><Icon name="menu" size={18} /> All categories <Icon name="chevron-down" size={16} /></button>
        <div class="mega">
          {
            mega.map((c) => (
              <div class="col">
                <h2>{c.title}</h2>
                <ul>
                  {c.items.map((i) => (
                    <li>
                      <a href="#">{i}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          <a class="promo" href="#">
            <b>Spring sale</b>
            <span>Up to 25% off selected models</span>
            <em>Shop deals <Icon name="arrow" size={16} /></em>
          </a>
        </div>
      </div>
      <ul class="links">
        {
          nav.map((n) => (
            <li>
              <a href="#" aria-current={n.current ? 'page' : undefined}>{n.label}</a>
            </li>
          ))
        }
      </ul>
      <a class="deal" href="#"><Icon name="tag" size={16} /> Weekly deals</a>
    </div>
  </nav>
</header>

<style>
  .util {
    border-bottom: 1px solid var(--line);
    background: #0a0b0c;
    font-size: 0.78rem;
    color: var(--mut);
  }
  .u-in {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 6px;
  }
  .u-in p {
    margin: 0;
  }
  .u-in ul {
    display: none;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .u-in a {
    text-decoration: none;
  }
  .u-in a:hover {
    color: var(--text);
  }
  .hd {
    position: relative;
    z-index: 60;
    background: var(--s1);
    border-bottom: 1px solid var(--line);
  }
  .main {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'logo acts' 'search search';
    gap: 12px 12px;
    align-items: center;
    padding-block: 14px;
  }
  .logo {
    grid-area: logo;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: max-content;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .logo span {
    font-weight: 500;
    color: var(--mut);
  }
  .search {
    grid-area: search;
    display: flex;
    min-width: 0;
    border: 1px solid #3a3f47;
    border-radius: 10px;
    background: var(--bg);
    overflow: hidden;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .search:focus-within {
    border-color: var(--acc);
    box-shadow: 0 0 0 3px rgb(255 122 26 / 0.2);
  }
  select {
    display: none;
    max-width: 190px;
    padding: 0 12px;
    border: 0;
    border-right: 1px solid #3a3f47;
    background: var(--s2);
    color: var(--text);
    font: inherit;
  }
  input {
    flex: 1;
    min-width: 0;
    min-height: 46px;
    padding: 0 14px;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
  }
  input:focus,
  select:focus {
    outline: none;
  }
  input::placeholder {
    color: #8b929c;
  }
  .search button {
    width: 56px;
    border: 0;
    background: var(--acc);
    color: #111;
    cursor: pointer;
    transition: background 0.15s;
  }
  .search button:hover {
    background: var(--acc-h);
  }
  .acts {
    grid-area: acts;
    display: flex;
    gap: 4px;
  }
  .acts a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-width: 46px;
    min-height: 46px;
    padding: 4px 8px;
    border-radius: 8px;
    font-size: 0.72rem;
    color: var(--mut);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .acts span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .acts a:hover {
    background: var(--s3);
    color: var(--text);
  }
  .cart b {
    position: absolute;
    inset: 0 2px auto auto;
    display: grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 9px;
    background: var(--acc);
    color: #111;
    font-size: 0.7rem;
  }
  .bar {
    border-top: 1px solid var(--line);
    background: var(--s2);
  }
  .bar-in {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .catwrap {
    position: relative;
  }
  .catbtn {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 46px;
    padding: 0 16px;
    border: 0;
    background: var(--acc);
    color: #111;
    font-weight: 650;
    cursor: pointer;
    white-space: nowrap;
  }
  .catbtn :global(svg:last-child) {
    transition: transform 0.2s;
  }
  .catwrap:hover .catbtn :global(svg:last-child),
  .catwrap:focus-within .catbtn :global(svg:last-child) {
    transform: rotate(180deg);
  }
  .mega {
    position: absolute;
    inset: 100% auto auto 0;
    z-index: 70;
    display: grid;
    grid-template-columns: repeat(3, 190px) 240px;
    gap: 28px;
    padding: 24px 28px 26px;
    border: 1px solid var(--line);
    border-top: 0;
    border-radius: 0 0 12px 12px;
    background: var(--s1);
    box-shadow: 0 24px 48px -12px rgb(0 0 0 / 0.8);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.2s, transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1), visibility 0s 0.25s;
  }
  .catwrap:hover .mega,
  .catwrap:focus-within .mega {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }
  .col h2 {
    margin: 0 0 10px;
    font-size: 0.85rem;
    font-weight: 650;
    color: var(--acc-h);
  }
  .col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .col a {
    display: block;
    padding: 5px 0;
    color: #d0d4da;
    text-decoration: none;
    transition: color 0.15s, transform 0.2s;
  }
  .col a:hover {
    color: #fff;
    transform: translateX(4px);
  }
  .promo {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 4px;
    padding: 18px;
    border-radius: 10px;
    background: linear-gradient(160deg, #3a2412, #1d1209);
    border: 1px solid #5a3a1e;
    text-decoration: none;
  }
  .promo b {
    font-size: 1.2rem;
  }
  .promo span {
    color: #d8c3ae;
    font-size: 0.85rem;
  }
  .promo em {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 8px;
    color: var(--acc-h);
    font-style: normal;
    font-weight: 650;
  }
  .links {
    display: flex;
    flex: 1;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .links a,
  .deal {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 46px;
    padding: 0 14px;
    color: #cfd3d9;
    font-weight: 550;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s, background 0.15s;
  }
  .links a:hover,
  .deal:hover {
    background: var(--s3);
    color: #fff;
  }
  .links a[aria-current] {
    color: #fff;
    box-shadow: inset 0 -2px 0 var(--acc);
  }
  .deal {
    display: none;
    color: var(--sale);
  }
  @media (max-width: 899px) {
    .mega {
      display: none;
    }
  }
  @media (min-width: 900px) {
    .u-in ul {
      display: flex;
    }
    .main {
      grid-template-columns: auto minmax(300px, 1fr) auto;
      grid-template-areas: 'logo search acts';
      gap: 28px;
    }
    select {
      display: block;
    }
    .acts span {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }
    .deal {
      display: inline-flex;
    }
  }
</style>
