---
import { getProduct, href } from '../data/products';
import type { Post } from '../data/posts';
import Art from './Art.astro';

interface Props {
  post: Post;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const product = getProduct(post.productId)!;
const link = href(`blog/${post.slug}/`);
---

<article class:list={['post zoom', { featured }]} data-tag={post.tag}>
  <a class="cover" href={link} tabindex="-1" aria-hidden="true"><Art product={product} /></a>
  <div class="body">
    <p class="meta"><span class="tag">{post.tag}</span> {post.date} · {post.readMin} min read</p>
    <h3><a href={link}>{post.title}</a></h3>
    <p class="ex">{post.excerpt}</p>
    <a class="read" href={link}>Read article<span class="sr">: {post.title}</span></a>
  </div>
</article>

<style>
  .post {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--s1);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.25s var(--ease);
  }
  .post:hover {
    border-color: #444a53;
    transform: translateY(-3px);
  }
  .cover {
    display: block;
    aspect-ratio: 16 / 9;
    background: radial-gradient(ellipse 70% 80% at 50% 40%, #343942, #16181b 80%);
    overflow: hidden;
  }
  .cover :global(.art) {
    padding: 2%;
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px 18px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: var(--mut);
    font-size: 0.82rem;
  }
  .tag {
    padding: 2px 9px;
    border-radius: 99px;
    background: rgb(255 122 26 / 0.14);
    color: var(--acc-h);
    font-weight: 650;
  }
  h3 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post {
    position: relative;
  }
  h3 a:hover {
    color: var(--acc-h);
  }
  .ex {
    margin: 0;
    color: #bcc2ca;
  }
  .read {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: 6px;
    color: var(--acc-h);
    font-weight: 650;
    text-decoration: none;
  }
  .read:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .featured {
    flex-direction: column;
  }
  @media (min-width: 900px) {
    .featured {
      flex-direction: row;
    }
    .featured .cover {
      flex: 1.2;
      aspect-ratio: auto;
      height: 340px;
    }
    .featured .read {
      margin-top: 14px;
    }
    .featured .body {
      flex: 1;
      justify-content: center;
      padding: 28px;
    }
    .featured h3 {
      font-size: 1.9rem;
      line-height: 1.15;
    }
    .featured .ex {
      font-size: 1.05rem;
    }
  }
</style>
