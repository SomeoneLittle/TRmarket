---
import { categoryName, formatCount, formatPrice, productHref, productSub, type Product } from '../data/products';
import Art from './Art.astro';
import Icon from './Icon.astro';
import Stars from './Stars.astro';

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const link = productHref(p);
const free = p.price === 0;
const off = p.oldPrice ? Math.round((1 - p.price / p.oldPrice) * 100) : 0;
const fresh = p.addedHours <= 30;
---

<article
  class="card"
  data-id={p.id}
  data-cat={p.category}
  data-sub={productSub(p)}
  data-price={p.price}
  data-old={p.oldPrice ?? 0}
  data-rating={p.rating}
  data-dl={p.downloads}
  data-added={p.addedHours}
  data-formats={p.formats.map((f) => f.toLowerCase()).join('|')}
  data-text={`${p.title} ${p.kind} ${p.formats.join(' ')} ${p.blurb}`.toLowerCase()}
>
  <div class="thumb zoom">
    <a class="art-link" href={link} tabindex="-1" aria-hidden="true"><Art product={p} label="" /></a>
    <div class="badges">
      {fresh && <span class="b new">New</span>}
      {off > 0 && <span class="b sale">−{off}%</span>}
      {free && <span class="b free">Free</span>}
    </div>
    <button class="fav" type="button" data-fav data-id={p.id} aria-pressed="false" aria-label={`Add ${p.title} to favorites`}>
      <Icon name="heart" size={18} />
    </button>
    <div class="quick">
      <button class="q ghost" type="button" data-quick data-id={p.id}><Icon name="eye" size={16} /> Quick view</button>
      <button class="q add" type="button" data-add data-id={p.id}>
        <Icon name={free ? 'download' : 'cart'} size={16} />
        {free ? 'Get' : 'Add'}
      </button>
    </div>
  </div>
  <div class="info">
    <p class="cat">{categoryName(p.category)} · {p.formats.join(', ')}</p>
    <h3><a href={link}>{p.title}</a></h3>
    <p class="desc">{p.blurb}</p>
    <p class="rate"><Stars rating={p.rating} label={`${p.rating.toFixed(1)} (${p.reviews})`} /></p>
    <p class="row">
      <span class="price">{formatPrice(p.price)}</span>
      {p.oldPrice && <s class="old">${p.oldPrice}</s>}
      <span class="dl"><Icon name="download" size={14} /> {formatCount(p.downloads)}</span>
    </p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--s1);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1), box-shadow 0.25s;
  }
  .card:hover,
  .card:focus-within {
    border-color: #444a53;
    transform: translateY(-3px);
    box-shadow: 0 14px 30px -14px rgb(0 0 0 / 0.8);
  }
  .thumb {
    position: relative;
    aspect-ratio: 4 / 3.3;
    overflow: hidden;
    background:
      linear-gradient(180deg, transparent 62%, rgb(0 0 0 / 0.35)),
      radial-gradient(ellipse 80% 70% at 50% 38%, #343942, #16181b 75%);
  }
  .art-link {
    display: block;
    height: 100%;
  }
  .thumb :global(.art) {
    padding: 4%;
  }
  .badges {
    position: absolute;
    inset: 10px auto auto 10px;
    display: flex;
    gap: 6px;
  }
  .b {
    padding: 2px 7px;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 700;
  }
  .new {
    background: var(--ok);
    color: #06150c;
  }
  .sale {
    background: var(--sale);
    color: #1c0507;
  }
  .free {
    background: #eceef1;
    color: #111;
  }
  .fav {
    position: absolute;
    inset: 8px 8px auto auto;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: rgb(14 15 17 / 0.72);
    cursor: pointer;
    transform: scale(0.8);
    opacity: 0;
    transition: opacity 0.2s, transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1), background 0.15s;
  }
  .card:hover .fav,
  .card:focus-within .fav,
  .fav[aria-pressed='true'] {
    opacity: 1;
    transform: none;
  }
  .fav:hover {
    background: var(--s3);
  }
  .fav[aria-pressed='true'] {
    color: var(--sale);
  }
  .fav[aria-pressed='true'] :global(path) {
    fill: currentColor;
  }
  .quick {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    gap: 8px;
    padding: 10px;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.75));
    transform: translateY(100%);
    transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .card:hover .quick,
  .card:focus-within .quick {
    transform: none;
  }
  .q {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 40px;
    border: 0;
    border-radius: 7px;
    font-size: 0.85rem;
    font-weight: 650;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s, transform 0.15s;
  }
  .q.ghost {
    background: rgb(236 238 241 / 0.14);
    backdrop-filter: blur(6px);
  }
  .q.ghost:hover {
    background: rgb(236 238 241 / 0.26);
  }
  .q.add {
    background: var(--acc);
    color: #111;
  }
  .q.add:hover {
    background: var(--acc-h);
  }
  .q:active {
    transform: scale(0.96);
  }
  @media (hover: none) {
    .quick {
      transform: none;
      position: static;
      background: none;
      padding: 0;
    }
    .fav {
      opacity: 1;
      transform: none;
    }
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 12px 14px 14px;
  }
  .cat {
    margin: 0;
    color: var(--mut);
    font-size: 0.78rem;
  }
  h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--acc-h);
  }
  .desc {
    display: none;
    margin: 2px 0 4px;
    color: #b9c0c9;
  }
  .rate {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 2px 0 0;
    color: var(--mut);
    font-size: 0.8rem;
  }
  .stars {
    background: linear-gradient(90deg, #ffb020 var(--p), #474c54 var(--p));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: 0.9rem;
    letter-spacing: 1px;
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 6px 0 0;
  }
  .price {
    font-size: 1.15rem;
    font-weight: 700;
  }
  .old {
    color: var(--mut);
    font-size: 0.85rem;
  }
  .dl {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    color: var(--mut);
    font-size: 0.8rem;
  }
</style>
