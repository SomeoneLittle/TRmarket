---
import { categoryName, formatCount, formatPrice, productHref, productSub, type Product } from '../data/products';
import Art from './Art.astro';
import Icon from './Icon.astro';
import Stars from './Stars.astro';

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const link = productHref(p);
const free = p.price === 0;
const off = p.oldPrice ? Math.round((1 - p.price / p.oldPrice) * 100) : 0;
const fresh = p.addedHours <= 30;
---

<div class="cardwrap">
<article
  class="card"
  data-id={p.id}
  data-cat={p.category}
  data-sub={productSub(p)}
  data-price={p.price}
  data-old={p.oldPrice ?? 0}
  data-rating={p.rating}
  data-dl={p.downloads}
  data-added={p.addedHours}
  data-formats={p.formats.map((f) => f.toLowerCase()).join('|')}
  data-text={`${p.title} ${p.kind} ${p.formats.join(' ')} ${p.blurb}`.toLowerCase()}
>
  <div class="thumb zoom">
    <a class="art-link" href={link} tabindex="-1" aria-hidden="true"><Art product={p} label="" /></a>
    <div class="badges">
      {fresh && <span class="b new">New</span>}
      {off > 0 && <span class="b sale">−{off}%</span>}
      {free && <span class="b free">Free</span>}
    </div>
    <button class="fav" type="button" data-fav data-id={p.id} aria-pressed="false" aria-label={`Add ${p.title} to favorites`}>
      <Icon name="heart" size={18} />
    </button>
    <button class="quick" type="button" data-quick data-id={p.id}>
      <Icon name="eye" size={16} /> Quick view<span class="sr">: {p.title}</span>
    </button>
  </div>

  <div class="info">
    <p class="cat">{categoryName(p.category)} · {p.formats.join(', ')}</p>
    <h3><a href={link}>{p.title}</a></h3>
    <p class="desc">{p.blurb}</p>
    <div class="rate">
      <Stars rating={p.rating} label={`${p.rating.toFixed(1)} (${p.reviews})`} />
      <span class="dl"><Icon name="download" size={14} /> {formatCount(p.downloads)}</span>
    </div>
    <div class="buy">
      <p class="price">
        <b>{formatPrice(p.price)}</b>
        {p.oldPrice && <s>${p.oldPrice}</s>}
      </p>
      <button class="add" type="button" data-add data-id={p.id}>
        <Icon name={free ? 'download' : 'cart'} size={16} />
        <span class="long">{free ? 'Get free' : 'Add to cart'}</span><span class="short" aria-hidden="true">{free ? 'Get' : 'Add'}</span><span class="sr">: {p.title}</span>
      </button>
    </div>
  </div>
</article>
</div>

<style>
  /* The wrapper never moves, so hovering near the edge cannot make the card flicker. */
  .cardwrap {
    display: flex;
    height: 100%;
  }
  .card {
    flex: 1;
    min-width: 0;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--s1);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.25s var(--ease), box-shadow 0.25s;
  }
  .cardwrap:hover .card,
  .card:focus-within {
    border-color: #444a53;
    transform: translateY(-3px);
    box-shadow: 0 14px 30px -14px rgb(0 0 0 / 0.8);
  }

  /* Image */
  .thumb {
    position: relative;
    flex: none;
    aspect-ratio: 4 / 3.2;
    overflow: hidden;
    background:
      linear-gradient(180deg, transparent 62%, rgb(0 0 0 / 0.35)),
      radial-gradient(ellipse 80% 70% at 50% 38%, #343942, #16181b 75%);
  }
  .art-link {
    display: block;
    height: 100%;
  }
  .thumb :global(.art) {
    padding: 4%;
  }
  .badges {
    position: absolute;
    inset: 10px auto auto 10px;
    display: flex;
    gap: 6px;
    pointer-events: none;
  }
  .b {
    padding: 2px 7px;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.5;
  }
  .new {
    background: var(--ok);
    color: #06150c;
  }
  .sale {
    background: var(--sale);
    color: #1c0507;
  }
  .free {
    background: #eceef1;
    color: #111;
  }
  .fav {
    position: absolute;
    inset: 8px 8px auto auto;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(14 15 17 / 0.72);
    color: var(--text);
    opacity: 0;
    cursor: pointer;
    transition: opacity 0.2s, background 0.15s, color 0.15s, transform 0.2s var(--ease);
  }
  .cardwrap:hover .fav,
  .card:focus-within .fav,
  .fav[aria-pressed='true'] {
    opacity: 1;
  }
  .fav:hover {
    background: var(--s3);
    transform: scale(1.08);
  }
  .fav:active {
    transform: scale(0.94);
  }
  .fav[aria-pressed='true'] {
    color: var(--sale);
  }
  .fav[aria-pressed='true'] :global(path) {
    fill: currentColor;
  }

  /* Quick view: a pill centred at the bottom of the image, shown on hover */
  .quick {
    position: absolute;
    left: 50%;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 38px;
    padding: 0 16px;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 99px;
    background: rgb(14 15 17 / 0.82);
    backdrop-filter: blur(6px);
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    opacity: 0;
    transform: translate(-50%, 10px);
    transition: opacity 0.2s, transform 0.28s var(--ease), background 0.15s;
  }
  .cardwrap:hover .quick,
  .card:focus-within .quick {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .quick:hover {
    background: var(--s3);
  }
  .quick:active {
    transform: translate(-50%, 0) scale(0.96);
  }
  @media (hover: none) {
    .fav {
      opacity: 1;
    }
    .quick {
      display: none;
    }
  }

  /* Text */
  .info {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px 14px;
  }
  .cat {
    margin: 0;
    color: var(--mut);
    font-size: 0.78rem;
  }
  h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--acc-h);
  }
  .desc {
    display: none;
    margin: 2px 0 4px;
    color: #b9c0c9;
  }
  .rate {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .dl {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--mut);
    font-size: 0.8rem;
  }

  /* Price and the add-to-cart button: always visible, aligned across cards */
  .buy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
    padding-top: 10px;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 0;
  }
  .price b {
    font-size: 1.15rem;
    font-weight: 700;
  }
  .price s {
    color: var(--mut);
    font-size: 0.85rem;
  }
  .add {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 14px;
    border: 0;
    border-radius: 8px;
    background: var(--acc);
    color: #111;
    font-size: 0.88rem;
    font-weight: 650;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.15s, transform 0.15s, box-shadow 0.2s;
  }
  .add:hover {
    background: var(--acc-h);
    box-shadow: 0 6px 16px -6px rgb(255 122 26 / 0.6);
  }
  .add:active {
    transform: scale(0.96);
  }
  .short {
    display: none;
  }
  @container (max-width: 235px) {
    .long {
      display: none;
    }
    .short {
      display: inline;
    }
    .add {
      padding: 0 12px;
    }
  }
</style>
