---
import { mainNav } from '../data/site';
import { href, marketHref, subcategories } from '../data/products';
import Icon from './Icon.astro';

interface Props {
  current?: string;
}
const { current } = Astro.props;

const mega = [
  { id: 'print', title: '3D models for printing' },
  { id: 'game', title: '3D models for games' },
  { id: 'tool', title: 'Tools' },
] as const;
---

<div class="util">
  <div class="wrap u-in">
    <p>Instant download · Commercial licence included · 30-day refunds</p>
    <ul>
      <li><a href={href('help/')}>Support</a></li>
      <li><a href={href('licenses/')}>Licences</a></li>
      <li><a href={href('contacts/')}>Contacts</a></li>
    </ul>
  </div>
</div>

<header class="hd">
  <div class="wrap in">
    <a class="logo" href={href()} aria-label="TRmarket, home">
      <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M16 3 27 9.5v13L16 29 5 22.5v-13z" fill="#ff7a1a"></path>
        <path d="M5 9.5 16 16l11-6.5M16 16v13" fill="none" stroke="#0e0f11" stroke-width="2"></path>
      </svg>
      TR<span>market</span>
    </a>

    <nav class="nav" aria-label="Main">
      <div class="catwrap">
        <a class="catbtn" href={href('marketplace/')} aria-haspopup="true"><Icon name="menu" size={18} /> All categories <Icon name="chevron-down" size={16} /></a>
        <div class="mega">
          {
            mega.map((c) => (
              <div class="col">
                <h2><a href={marketHref({ cat: c.id })}>{c.title}</a></h2>
                <ul>
                  {subcategories[c.id].map((s) => (
                    <li>
                      <a href={marketHref({ cat: c.id, sub: s.id })}>{s.name}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          <a class="promo" href={marketHref({ sale: '1' })}>
            <b>Weekly deals</b>
            <span>Up to 25% off selected models</span>
            <em>Shop deals <Icon name="arrow" size={16} /></em>
          </a>
        </div>
      </div>
      <ul class="links">
        {
          mainNav.map((n) => (
            <li>
              <a href={n.href} aria-current={n.id === current ? 'page' : undefined}>{n.label}</a>
            </li>
          ))
        }
      </ul>
      <form class="search" id="site-search" role="search" action={href('marketplace/')} method="get" aria-hidden="true">
        <div class="field">
          <Icon name="search" size={20} />
          <label class="sr" for="site-q">Search the catalog</label>
          <input id="site-q" name="q" type="search" placeholder="Search 3D models, brushes, add-ons…" autocomplete="off" tabindex="-1" />
          <button class="go" type="submit" tabindex="-1">Search</button>
          <button class="close" type="button" data-search-close aria-label="Close search" tabindex="-1"><Icon name="close" size={20} /></button>
        </div>
        <ul id="suggest" class="suggest" hidden></ul>
      </form>
    </nav>

    <div class="acts">
      <button class="sbtn" type="button" data-search-toggle aria-expanded="false" aria-controls="site-search" aria-label="Search">
        <Icon name="search" size={22} />
      </button>
      <a href={href('account/favorites/')}>
        <Icon name="heart" size={22} /><span>Favorites</span>
        <b data-fav-count hidden>0</b>
      </a>
      <a href={href('account/')}><Icon name="user" size={22} /><span data-user-name>Account</span></a>
      <a href={href('cart/')} class="cart">
        <Icon name="cart" size={22} />
        <span>Cart</span>
        <b data-cart-count hidden>0</b>
      </a>
    </div>
  </div>

</header>

<style>
  .util {
    border-bottom: 1px solid var(--line);
    background: #0a0b0c;
    font-size: 0.78rem;
    color: var(--mut);
  }
  .u-in {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 6px;
  }
  .u-in p {
    margin: 0;
  }
  .u-in ul {
    display: none;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .u-in a {
    text-decoration: none;
  }
  .u-in a:hover {
    color: var(--text);
  }

  .hd {
    position: relative;
    z-index: 60;
    background: var(--s1);
    border-bottom: 1px solid var(--line);
  }
  .in {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'logo acts' 'nav nav';
    align-items: center;
    gap: 0 12px;
  }
  .logo {
    grid-area: logo;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: max-content;
    padding-block: 12px;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .logo span {
    font-weight: 500;
    color: var(--mut);
  }

  /* Navigation: categories button, mega menu and links */
  .nav {
    grid-area: nav;
    display: flex;
    align-items: stretch;
    gap: 4px;
    min-width: 0;
    border-top: 1px solid var(--line);
  }
  .catwrap {
    flex: none;
  }
  .catbtn {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 100%;
    min-height: 46px;
    padding: 0 16px;
    border-radius: 0;
    background: var(--acc);
    color: #111;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .catbtn:hover {
    background: var(--acc-h);
  }
  .catbtn :global(svg:last-child) {
    transition: transform 0.2s;
  }
  .catwrap:hover .catbtn :global(svg:last-child),
  .catwrap:focus-within .catbtn :global(svg:last-child) {
    transform: rotate(180deg);
  }
  .mega {
    position: absolute;
    inset: 100% 0 auto 0;
    z-index: 70;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) 260px;
    gap: 28px;
    padding: 24px 28px 26px;
    border: 1px solid var(--line);
    border-top: 0;
    border-radius: 0 0 12px 12px;
    background: var(--s1);
    box-shadow: 0 24px 48px -12px rgb(0 0 0 / 0.8);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.2s, transform 0.25s var(--ease), visibility 0s 0.25s;
  }
  .catwrap:hover .mega,
  .catwrap:focus-within .mega {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }
  .col h2 {
    margin: 0 0 10px;
    font-size: 0.85rem;
    font-weight: 650;
  }
  .col h2 a {
    color: var(--acc-h);
    text-decoration: none;
  }
  .col h2 a:hover {
    text-decoration: underline;
  }
  .col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .col li a {
    display: block;
    padding: 5px 0;
    color: #d0d4da;
    text-decoration: none;
    transition: color 0.15s, transform 0.2s;
  }
  .col li a:hover {
    color: #fff;
    transform: translateX(4px);
  }
  .promo {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 4px;
    padding: 18px;
    border: 1px solid #5a3a1e;
    border-radius: 10px;
    background: linear-gradient(160deg, #3a2412, #1d1209);
    text-decoration: none;
  }
  .promo b {
    font-size: 1.2rem;
  }
  .promo span {
    color: #d8c3ae;
    font-size: 0.85rem;
  }
  .promo em {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 8px;
    color: var(--acc-h);
    font-style: normal;
    font-weight: 650;
  }
  .links {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    align-items: stretch;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .links li {
    display: flex;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 46px;
    padding: 0 14px;
    color: #cfd3d9;
    font-weight: 550;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s, background 0.15s;
  }
  .links a:hover {
    background: var(--s3);
    color: #fff;
  }
  .links a[aria-current] {
    color: #fff;
    box-shadow: inset 0 -2px 0 var(--acc);
  }

  /* Header actions */
  .acts {
    grid-area: acts;
    display: flex;
    gap: 2px;
    justify-self: end;
  }
  .acts a,
  .acts button {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-width: 48px;
    min-height: 48px;
    padding: 4px 8px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--mut);
    font-size: 0.72rem;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .acts span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .acts a:hover,
  .acts button:hover,
  .acts button[aria-expanded='true'] {
    background: var(--s3);
    color: var(--text);
  }
  .acts b {
    position: absolute;
    inset: 2px 4px auto auto;
    display: grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 9px;
    background: var(--acc);
    color: #111;
    font-size: 0.7rem;
  }

  /* Search: an orange icon button opens a field that fills the free space of the header row */
  .acts .sbtn {
    min-width: 46px;
    min-height: 46px;
    margin-right: 6px;
    background: var(--acc);
    color: #111;
  }
  .acts .sbtn:hover {
    background: var(--acc-h);
    color: #111;
  }
  .acts .sbtn[aria-expanded='true'] {
    background: #d9650f;
    color: #111;
  }
  .nav {
    position: relative;
  }
  .search {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    padding: 6px 0 6px 6px;
    background: var(--s1);
    pointer-events: none;
    visibility: hidden;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.32s var(--ease), visibility 0s 0.32s;
  }
  .search.open {
    pointer-events: auto;
    visibility: visible;
    clip-path: inset(0 -400px -600px 0);
    transition-delay: 0s;
  }
  .field {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 10px;
    min-width: 0;
    height: 100%;
    min-height: 46px;
    padding: 0 6px 0 14px;
    border: 1px solid #3a3f47;
    border-radius: 10px;
    background: var(--bg);
    color: var(--mut);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .field:focus-within {
    border-color: var(--acc);
    box-shadow: 0 0 0 3px rgb(255 122 26 / 0.2);
  }
  .field input {
    flex: 1;
    min-width: 0;
    min-height: 40px;
    border: 0;
    background: none;
    color: var(--text);
    font-size: 1rem;
  }
  .field input:focus {
    outline: none;
  }
  .field input::placeholder {
    color: #8b929c;
  }
  .go {
    display: none;
    min-height: 34px;
    padding: 0 16px;
    border: 0;
    border-radius: 7px;
    background: var(--acc);
    color: #111;
    font-weight: 650;
    cursor: pointer;
    transition: background 0.15s;
  }
  .go:hover {
    background: var(--acc-h);
  }
  .close {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 7px;
    background: none;
    color: var(--mut);
    cursor: pointer;
  }
  .close:hover {
    background: var(--s3);
    color: var(--text);
  }
  .suggest {
    position: absolute;
    inset: calc(100% + 2px) 0 auto 6px;
    z-index: 80;
    margin: 0;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--s2);
    box-shadow: 0 20px 40px -12px rgb(0 0 0 / 0.8);
    list-style: none;
  }
  .suggest :global(a) {
    display: grid;
    gap: 1px;
    padding: 9px 12px;
    border-radius: 7px;
    text-decoration: none;
  }
  .suggest :global(a:hover),
  .suggest :global(a:focus-visible) {
    background: var(--s3);
  }
  .suggest :global(span) {
    color: var(--mut);
    font-size: 0.82rem;
  }
  .suggest :global(a.all) {
    color: var(--acc-h);
    font-weight: 600;
  }

  @media (max-width: 420px) {
    .logo {
      font-size: 1.35rem;
    }
    .logo span {
      display: none;
    }
    .acts a,
    .acts button {
      min-width: 44px;
      padding-inline: 6px;
    }
  }
  @media (max-width: 899px) {
    .mega {
      display: none;
    }
  }
  @media (min-width: 900px) {
    .u-in ul {
      display: flex;
    }
    .in {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: 'logo nav acts';
      gap: 0 28px;
    }
    .nav {
      align-self: stretch;
      border-top: 0;
    }
    .acts span {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }
    .links {
      flex: none;
      overflow: visible;
    }
    .search {
      position: relative;
      inset: auto;
      flex: 1;
      min-width: 0;
      padding: 6px 8px 6px 10px;
      background: none;
    }
    .suggest {
      inset: 100% auto auto 10px;
      width: max(100% - 10px, 420px);
    }
  }
</style>

<script>
  // Collapsed search: the icon opens a bar under the header.
  const form = document.getElementById('site-search') as HTMLFormElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-search-toggle]')!;
  const input = form.querySelector<HTMLInputElement>('input[name="q"]')!;
  const focusables = form.querySelectorAll<HTMLElement>('input, button');

  const set = (open: boolean) => {
    form.classList.toggle('open', open);
    form.setAttribute('aria-hidden', String(!open));
    toggle.setAttribute('aria-expanded', String(open));
    focusables.forEach((el) => (el.tabIndex = open ? 0 : -1));
    if (open) input.focus();
    else document.getElementById('suggest')!.hidden = true;
  };
  toggle.addEventListener('click', () => set(!form.classList.contains('open')));
  form.querySelector('[data-search-close]')!.addEventListener('click', () => {
    set(false);
    toggle.focus();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && form.classList.contains('open')) {
      set(false);
      toggle.focus();
    }
  });
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (form.classList.contains('open') && !form.contains(t) && !toggle.contains(t)) set(false);
  });
</script>
