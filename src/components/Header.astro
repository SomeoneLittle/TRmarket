---
import { mainNav } from '../data/site';
import { href, marketHref, subcategories } from '../data/products';
import Icon from './Icon.astro';

interface Props {
  current?: string;
}
const { current } = Astro.props;

const mega = [
  { id: 'print', title: '3D models for printing' },
  { id: 'game', title: '3D models for games' },
  { id: 'tool', title: 'Tools' },
] as const;
---

<div class="util">
  <div class="wrap u-in">
    <p>Instant download · Commercial licence included · 30-day refunds</p>
    <ul>
      <li><a href={href('help/')}>Support</a></li>
      <li><a href={href('licenses/')}>Licences</a></li>
      <li><a href={href('contacts/')}>Contacts</a></li>
    </ul>
  </div>
</div>

<header class="hd">
  <div class="wrap main">
    <a class="logo" href={href()} aria-label="TRmarket, home">
      <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M16 3 27 9.5v13L16 29 5 22.5v-13z" fill="#ff7a1a"></path>
        <path d="M5 9.5 16 16l11-6.5M16 16v13" fill="none" stroke="#0e0f11" stroke-width="2"></path>
      </svg>
      TR<span>market</span>
    </a>

    <form class="search" role="search" action={href('marketplace/')} method="get">
      <label class="sr" for="site-cat">Category</label>
      <select id="site-cat" name="cat">
        <option value="">All categories</option>
        <option value="print">3D models for printing</option>
        <option value="game">3D models for games</option>
        <option value="tool">Tools</option>
      </select>
      <label class="sr" for="site-q">Search</label>
      <input id="site-q" name="q" type="search" placeholder="Search 3D models, brushes, add-ons…" autocomplete="off" />
      <button type="submit" aria-label="Search"><Icon name="search" size={20} /></button>
      <ul id="suggest" class="suggest" hidden></ul>
    </form>

    <div class="acts">
      <a href={href('account/favorites/')}>
        <Icon name="heart" size={22} /><span>Favorites</span>
        <b data-fav-count hidden>0</b>
      </a>
      <a href={href('account/')}><Icon name="user" size={22} /><span data-user-name>Account</span></a>
      <a href={href('cart/')} class="cart">
        <Icon name="cart" size={22} />
        <span>Cart</span>
        <b data-cart-count hidden>0</b>
      </a>
    </div>
  </div>

  <nav class="bar" aria-label="Main">
    <div class="wrap bar-in">
      <div class="catwrap">
        <button class="catbtn" type="button" aria-haspopup="true"><Icon name="menu" size={18} /> All categories <Icon name="chevron-down" size={16} /></button>
        <div class="mega">
          {
            mega.map((c) => (
              <div class="col">
                <h2><a href={marketHref({ cat: c.id })}>{c.title}</a></h2>
                <ul>
                  {subcategories[c.id].map((s) => (
                    <li>
                      <a href={marketHref({ cat: c.id, sub: s.id })}>{s.name}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          <a class="promo" href={marketHref({ sale: '1' })}>
            <b>Weekly deals</b>
            <span>Up to 25% off selected models</span>
            <em>Shop deals <Icon name="arrow" size={16} /></em>
          </a>
        </div>
      </div>
      <ul class="links">
        {
          mainNav.map((n) => (
            <li>
              <a href={n.href} aria-current={n.id === current ? 'page' : undefined}>{n.label}</a>
            </li>
          ))
        }
      </ul>
      <a class="deal" href={marketHref({ sale: '1' })}><Icon name="tag" size={16} /> Weekly deals</a>
    </div>
  </nav>
</header>

<style>
  .util {
    border-bottom: 1px solid var(--line);
    background: #0a0b0c;
    font-size: 0.78rem;
    color: var(--mut);
  }
  .u-in {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 6px;
  }
  .u-in p {
    margin: 0;
  }
  .u-in ul {
    display: none;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .u-in a {
    text-decoration: none;
  }
  .u-in a:hover {
    color: var(--text);
  }
  .hd {
    position: relative;
    z-index: 60;
    background: var(--s1);
    border-bottom: 1px solid var(--line);
  }
  .main {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'logo acts' 'search search';
    gap: 12px 12px;
    align-items: center;
    padding-block: 14px;
  }
  .logo {
    grid-area: logo;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: max-content;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .logo span {
    font-weight: 500;
    color: var(--mut);
  }
  .search {
    position: relative;
    grid-area: search;
    display: flex;
    min-width: 0;
    border: 1px solid #3a3f47;
    border-radius: 10px;
    background: var(--bg);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .search:focus-within {
    border-color: var(--acc);
    box-shadow: 0 0 0 3px rgb(255 122 26 / 0.2);
  }
  select {
    display: none;
    border-radius: 9px 0 0 9px;
    max-width: 190px;
    padding: 0 12px;
    border: 0;
    border-right: 1px solid #3a3f47;
    background: var(--s2);
    color: var(--text);
    font: inherit;
  }
  input {
    flex: 1;
    min-width: 0;
    min-height: 46px;
    padding: 0 14px;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
  }
  input:focus,
  select:focus {
    outline: none;
  }
  input::placeholder {
    color: #8b929c;
  }
  .search button {
    width: 56px;
    border-radius: 0 9px 9px 0;
    border: 0;
    background: var(--acc);
    color: #111;
    cursor: pointer;
    transition: background 0.15s;
  }
  .search button:hover {
    background: var(--acc-h);
  }
  .suggest {
    position: absolute;
    inset: calc(100% + 6px) 0 auto;
    z-index: 80;
    margin: 0;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--s1);
    box-shadow: 0 20px 40px -12px rgb(0 0 0 / 0.8);
    list-style: none;
  }
  .suggest :global(a) {
    display: grid;
    gap: 1px;
    padding: 9px 12px;
    border-radius: 7px;
    text-decoration: none;
  }
  .suggest :global(a:hover),
  .suggest :global(a:focus-visible) {
    background: var(--s3);
  }
  .suggest :global(span) {
    color: var(--mut);
    font-size: 0.82rem;
  }
  .suggest :global(a.all) {
    color: var(--acc-h);
    font-weight: 600;
  }
  .acts {
    grid-area: acts;
    display: flex;
    gap: 4px;
  }
  .acts a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-width: 46px;
    min-height: 46px;
    padding: 4px 8px;
    border-radius: 8px;
    font-size: 0.72rem;
    color: var(--mut);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .acts span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .acts a:hover {
    background: var(--s3);
    color: var(--text);
  }
  .acts b {
    position: absolute;
    inset: 0 2px auto auto;
    display: grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 9px;
    background: var(--acc);
    color: #111;
    font-size: 0.7rem;
  }
  .bar {
    border-top: 1px solid var(--line);
    background: var(--s2);
  }
  .bar-in {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .catwrap {
    position: relative;
  }
  .catbtn {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 46px;
    padding: 0 16px;
    border: 0;
    background: var(--acc);
    color: #111;
    font-weight: 650;
    cursor: pointer;
    white-space: nowrap;
  }
  .catbtn :global(svg:last-child) {
    transition: transform 0.2s;
  }
  .catwrap:hover .catbtn :global(svg:last-child),
  .catwrap:focus-within .catbtn :global(svg:last-child) {
    transform: rotate(180deg);
  }
  .mega {
    position: absolute;
    inset: 100% auto auto 0;
    z-index: 70;
    display: grid;
    grid-template-columns: repeat(3, 190px) 240px;
    gap: 28px;
    padding: 24px 28px 26px;
    border: 1px solid var(--line);
    border-top: 0;
    border-radius: 0 0 12px 12px;
    background: var(--s1);
    box-shadow: 0 24px 48px -12px rgb(0 0 0 / 0.8);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.2s, transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1), visibility 0s 0.25s;
  }
  .catwrap:hover .mega,
  .catwrap:focus-within .mega {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }
  .col h2 {
    margin: 0 0 10px;
    font-size: 0.85rem;
    font-weight: 650;
    color: var(--acc-h);
  }
  .col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .col a {
    display: block;
    padding: 5px 0;
    color: #d0d4da;
    text-decoration: none;
    transition: color 0.15s, transform 0.2s;
  }
  .col a:hover {
    color: #fff;
    transform: translateX(4px);
  }
  .promo {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 4px;
    padding: 18px;
    border-radius: 10px;
    background: linear-gradient(160deg, #3a2412, #1d1209);
    border: 1px solid #5a3a1e;
    text-decoration: none;
  }
  .promo b {
    font-size: 1.2rem;
  }
  .promo span {
    color: #d8c3ae;
    font-size: 0.85rem;
  }
  .promo em {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 8px;
    color: var(--acc-h);
    font-style: normal;
    font-weight: 650;
  }
  .links {
    display: flex;
    flex: 1;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .links a,
  .deal {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 46px;
    padding: 0 14px;
    color: #cfd3d9;
    font-weight: 550;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s, background 0.15s;
  }
  .links a:hover,
  .deal:hover {
    background: var(--s3);
    color: #fff;
  }
  .links a[aria-current] {
    color: #fff;
    box-shadow: inset 0 -2px 0 var(--acc);
  }
  .deal {
    display: none;
    color: var(--sale);
  }
  @media (max-width: 899px) {
    .mega {
      display: none;
    }
  }
  @media (min-width: 900px) {
    .u-in ul {
      display: flex;
    }
    .main {
      grid-template-columns: auto minmax(300px, 1fr) auto;
      grid-template-areas: 'logo search acts';
      gap: 28px;
    }
    select {
      display: block;
    }
    .acts span {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }
    .deal {
      display: inline-flex;
    }
  }
</style>
