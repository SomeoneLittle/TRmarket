---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Art from '../../components/Art.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import ProductCard from '../../components/ProductCard.astro';
import SectionHead from '../../components/SectionHead.astro';
import { posts, type Post } from '../../data/posts';
import { getProduct, href } from '../../data/products';

export function getStaticPaths() {
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, prev: posts[i + 1], next: posts[i - 1] },
  }));
}

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}
const { post, prev, next } = Astro.props;
const product = getProduct(post.productId)!;
const mentioned = post.related.map((id) => getProduct(id)!).filter(Boolean);
const more = posts.filter((p) => p.slug !== post.slug).slice(0, 3);
const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const toc = post.body.filter((b) => b.type === 'h2').map((b) => ({ id: slug((b as { text: string }).text), text: (b as { text: string }).text }));
---

<Layout title={post.title} current="blog" description={post.excerpt}>
  <div class="wrap">
    <Breadcrumbs items={[{ label: 'Blog', href: href('blog/') }, { label: post.title }]} />

    <header class="head">
      <p class="meta"><a class="tag" href={href('blog/')}>{post.tag}</a> {post.date} · {post.readMin} min read</p>
      <h1>{post.title}</h1>
      <p class="lead">{post.excerpt}</p>
    </header>

    <div class="cover"><Art product={product} label={`Illustration: ${product.title}`} /></div>

    <div class="layout">
      <article class="prose">
        {
          post.body.map((b) =>
            b.type === 'h2' ? (
              <h2 id={slug(b.text)}>{b.text}</h2>
            ) : b.type === 'p' ? (
              <p>{b.text}</p>
            ) : (
              <ul>{b.items.map((i) => <li>{i}</li>)}</ul>
            ),
          )
        }

        <div class="share">
          <span>Share this article</span>
          <button class="btn ghost sm" type="button" data-copy><Icon name="share" size={16} /> Copy link</button>
        </div>
      </article>

      <aside class="side">
        {
          toc.length > 0 && (
            <nav class="toc" aria-label="In this article">
              <h2>In this article</h2>
              <ol>
                {toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
              </ol>
            </nav>
          )
        }
        <div class="cta panel">
          <p class="eyebrow">Mentioned</p>
          <h2>{product.title}</h2>
          <p>{product.blurb}</p>
          <a class="btn block" href={href(`product/${product.id}/`)}>View product <Icon name="arrow" size={16} /></a>
        </div>
      </aside>
    </div>

    <nav class="pn" aria-label="More articles">
      {prev ? <a class="prev" href={href(`blog/${prev.slug}/`)}><small>← Older</small><b>{prev.title}</b></a> : <span />}
      {next ? <a class="next" href={href(`blog/${next.slug}/`)}><small>Newer →</small><b>{next.title}</b></a> : <span />}
    </nav>

    <section class="sec" aria-labelledby="ment">
      <SectionHead id="ment" title="Products from this article" href={href('marketplace/')} label="Browse the catalog" />
      <ul class="grid4 g3">
        {mentioned.map((p) => <li><ProductCard product={p} /></li>)}
      </ul>
    </section>

    <section class="sec" aria-labelledby="more">
      <SectionHead id="more" title="Keep reading" href={href('blog/')} label="All articles" />
      <ul class="posts">
        {more.map((p) => <li><PostCard post={p} /></li>)}
      </ul>
    </section>
  </div>
</Layout>

<style>
  .head {
    max-width: 52rem;
    padding: 18px 0 18px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
    color: var(--mut);
  }
  .tag {
    padding: 2px 10px;
    border-radius: var(--r-pill);
    background: rgb(var(--acc-rgb) / 0.14);
    color: var(--acc-h);
    font-weight: 650;
    text-decoration: none;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .lead {
    margin: 12px 0 0;
    color: var(--text-soft);
    font-size: 1.15rem;
  }
  .cover {
    aspect-ratio: 16 / 7;
    border: 1px solid var(--line);
    border-radius: var(--r-3xl);
    background: radial-gradient(ellipse 60% 80% at 50% 40%, var(--art-hi), var(--art-lo) 80%);
    overflow: hidden;
  }
  .cover :global(.art) {
    padding: 2%;
  }
  .layout {
    display: grid;
    gap: 28px;
    margin-top: 28px;
  }
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--mut);
  }
  .side {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .toc h2,
  .cta h2 {
    margin: 0 0 8px;
    font-size: 1rem;
  }
  .toc ol {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
    list-style: none;
  }
  .toc a {
    display: block;
    padding: 6px 12px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--mut);
    text-decoration: none;
    transition: color var(--dur-fast), border-color var(--dur-base);
  }
  .toc a:hover {
    color: var(--text);
  }
  .toc a.on {
    border-left-color: var(--acc);
    color: var(--text);
  }
  .eyebrow {
    margin: 0 0 4px;
    color: var(--acc-h);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .cta p:not(.eyebrow) {
    margin: 0 0 14px;
    color: var(--mut);
  }
  .pn {
    display: grid;
    gap: 12px;
    margin-top: 36px;
  }
  .pn a {
    display: grid;
    gap: 2px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--s1);
    text-decoration: none;
    transition: border-color var(--dur-base), background var(--dur-base);
  }
  .pn a:hover {
    border-color: var(--acc);
    background: var(--s2);
  }
  .pn small {
    color: var(--mut);
  }
  .next {
    text-align: right;
  }
  .g3 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .posts {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .posts > li {
    display: flex;
  }
  .posts > li > :global(*) {
    flex: 1;
  }
  @media (min-width: 700px) {
    .pn {
      grid-template-columns: 1fr 1fr;
    }
    .g3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .posts {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 56px;
      align-items: start;
    }
    .side {
      position: sticky;
      top: 90px;
    }
  }
</style>

<script>
  // Highlight the table-of-contents entry for the section being read.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const sections = links.map((a) => document.getElementById(a.hash.slice(1))).filter((el): el is HTMLElement => !!el);
  if (sections.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (en.isIntersecting) {
            links.forEach((a) => a.classList.toggle('on', a.hash === `#${en.target.id}`));
          }
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    sections.forEach((s) => io.observe(s));
    links[0].classList.add('on');
  }
</script>
