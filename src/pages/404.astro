---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { href } from '../lib/url';
import { getPopularProducts } from '..//lib/data';

const picks = await getPopularProducts(4, { includeFree: true });
---

<Layout title="Page not found" description="This page does not exist.">
  <div class="wrap">
    <div class="nf">
      <p class="code">404</p>
      <h1>This page got lost in the mesh</h1>
      <p>The page you are looking for does not exist or has moved. Try the catalog or head back home.</p>
      <div class="actions">
        <a class="btn" href={href()}>Go home</a>
        <a class="btn ghost" href={href('marketplace/')}>Browse the marketplace</a>
      </div>
    </div>
    <h2 class="t">Popular right now</h2>
    <ul class="grid4">
      {picks.map((p) => <li><ProductCard product={p} /></li>)}
    </ul>
  </div>
</Layout>

<style>
  .nf {
    padding: clamp(2.5rem, 8vw, 5rem) 0 2.5rem;
    text-align: center;
  }
  .code {
    margin: 0;
    color: var(--acc);
    font-size: clamp(4rem, 14vw, 8rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 1;
  }
  h1 {
    margin: 8px 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    letter-spacing: -0.03em;
  }
  .nf p:not(.code) {
    max-width: 32rem;
    margin: 0 auto 20px;
    color: var(--mut);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .t {
    margin-bottom: 16px;
  }
</style>
