---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import CartLine from '../../components/CartLine.astro';
import OrderSummary from '../../components/OrderSummary.astro';
import Icon from '../../components/Icon.astro';
import { href, products } from '../../data/products';

const methods = [
  { id: 'card', title: 'Bank card', text: 'Visa, Mastercard and others' },
  { id: 'bank', title: 'Bank transfer', text: 'Invoice sent by email' },
  { id: 'crypto', title: 'Crypto', text: 'Stablecoins accepted' },
];
---

<Layout title="Checkout" description="Complete your order.">
  <div data-cart-root>
    <PageHead title="Checkout" crumbs={[{ label: 'Cart', href: href('cart/') }, { label: 'Checkout' }]} />
    <div class="wrap">
      <p class="demo"><Icon name="info" size={18} /> This is a design demo: no payment is taken and nothing is sent anywhere.</p>

      <div class="empty" data-empty hidden>
        <h2>Your cart is empty</h2>
        <p>Add something to your cart before checking out.</p>
        <a class="btn" href={href('marketplace/')}>Browse the marketplace</a>
      </div>

      <div class="layout" data-filled hidden>
        <form class="form" id="checkout-form" data-checkout novalidate>
          <section class="panel">
            <h2>Contact</h2>
            <div class="row2">
              <div class="field"><label for="co-name">Full name</label><input id="co-name" name="name" autocomplete="name" required minlength="2" /></div>
              <div class="field"><label for="co-email">Email</label><input id="co-email" name="email" type="email" autocomplete="email" required /><span class="hint">Your files and receipt go here.</span></div>
            </div>
            <div class="row2">
              <div class="field">
                <label for="co-country">Country</label>
                <select id="co-country" name="country" required>
                  <option value="">Select…</option>
                  <option>Germany</option><option>Netherlands</option><option>Poland</option><option>Serbia</option><option>Spain</option><option>United Kingdom</option><option>United States</option><option>Other</option>
                </select>
              </div>
              <div class="field"><label for="co-company">Company <small>(optional)</small></label><input id="co-company" name="company" autocomplete="organization" /></div>
            </div>
          </section>

          <fieldset class="panel pay">
            <legend>Payment method</legend>
            <div class="methods">
              {
                methods.map((m, i) => (
                  <label>
                    <input type="radio" name="method" value={m.id} checked={i === 0} />
                    <span class="m"><b>{m.title}</b><small>{m.text}</small></span>
                  </label>
                ))
              }
            </div>
            <p class="hint"><Icon name="lock" size={14} /> Card details are not collected in this demo.</p>
          </fieldset>

          <div class="panel agree">
            <label class="check"><input type="checkbox" name="terms" required /> <span>I agree to the <a href={href('terms/')}>terms of sale</a> and the <a href={href('licenses/')}>licence terms</a>.</span></label>
            <label class="check"><input type="checkbox" name="news" /> <span>Send me one short email a week with new models and free drops.</span></label>
          </div>
        </form>

        <OrderSummary title="Your order" promo={false}>
          <ul slot="lines" class="lines">
            {products.map((p) => <CartLine product={p} compact />)}
          </ul>
          <button class="btn block" type="submit" form="checkout-form" data-needs-items data-pay><Icon name="lock" size={18} /> Place order</button>
          <a class="more" href={href('cart/')}>← Edit cart</a>
        </OrderSummary>
      </div>
    </div>
  </div>
</Layout>

<style>
  .demo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 8px 0 20px;
    padding: 12px 16px;
    border: 1px solid #5a4630;
    border-radius: 10px;
    background: rgb(255 122 26 / 0.08);
    color: #f0cfa8;
  }
  .layout {
    display: grid;
    gap: 24px;
  }
  .form {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .panel h2 {
    margin: 0 0 14px;
    font-size: 1.15rem;
  }
  .row2 {
    display: grid;
    gap: 0 14px;
  }
  .pay {
    margin: 0;
  }
  legend {
    padding: 0 6px;
    font-size: 1.15rem;
    font-weight: 700;
  }
  .methods {
    display: grid;
    gap: 10px;
    margin-top: 6px;
  }
  .methods label {
    position: relative;
    cursor: pointer;
  }
  .methods input {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .m {
    display: grid;
    padding: 12px 14px;
    border: 1px solid #3a3f47;
    border-radius: 10px;
    background: var(--bg);
    transition: border-color 0.2s, background 0.2s;
  }
  .m small {
    color: var(--mut);
  }
  .methods label:hover .m {
    border-color: #5a616c;
  }
  .methods input:checked + .m {
    border-color: var(--acc);
    background: rgb(255 122 26 / 0.08);
    box-shadow: 0 0 0 1px var(--acc);
  }
  .methods input:focus-visible + .m {
    outline: 2px solid var(--acc-h);
    outline-offset: 2px;
  }
  .hint {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 12px 0 0;
    color: var(--mut);
    font-size: 0.85rem;
  }
  .agree {
    display: grid;
    gap: 6px;
  }
  .agree a {
    color: var(--acc-h);
  }
  .lines {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .more {
    justify-self: center;
  }
  @media (min-width: 640px) {
    .row2 {
      grid-template-columns: 1fr 1fr;
    }
    .methods {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 380px;
      gap: 40px;
      align-items: start;
    }
    .layout :global(.summary) {
      position: sticky;
      top: 86px;
    }
  }
</style>

<script>
  import { mountCart } from '../../scripts/cart';
  import { addOwned, cartTotals, clearCart, getUser, url } from '../../scripts/store';
  import { toast } from '../../scripts/ui';

  mountCart(document.querySelector<HTMLElement>('[data-cart-root]')!);

  const form = document.querySelector<HTMLFormElement>('[data-checkout]')!;
  const user = getUser();
  if (user) {
    form.querySelector<HTMLInputElement>('[name="name"]')!.value = user.name;
    form.querySelector<HTMLInputElement>('[name="email"]')!.value = user.email;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      toast('Please complete the highlighted fields');
      return;
    }
    const t = cartTotals();
    if (t.lines.length === 0) return;
    const order = {
      number: `TR-${Date.now().toString().slice(-6)}`,
      total: t.total,
      ids: t.lines.map((l) => l.p.id),
      email: (form.querySelector<HTMLInputElement>('[name="email"]')!).value,
    };
    try {
      sessionStorage.setItem('trm.order', JSON.stringify(order));
    } catch {
      /* ignore */
    }
    addOwned(t.lines.map((l) => l.item));
    clearCart();
    location.href = url('checkout/success/');
  });
</script>
